diff --git a/app/(site)/brief/rates.ts b/app/(site)/brief/rates.ts
new file mode 100644
index 0000000..48bd0a7
--- /dev/null
+++ b/app/(site)/brief/rates.ts
@@ -0,0 +1,132 @@
+import { createEstimate, todayRates } from "./estimate";
+import type { BriefEstimate, ProjectBrief, RateStamp, RateTable, RatesGap } from "./types";
+
+/**
+ * Rate versions for the brief engine. Catalog numbers used to feed the
+ * estimate directly, so any catalog edit quietly moved every saved brief.
+ * A rate table is now data with a version: saving stamps the brief with the
+ * version it used, and a stamped brief keeps reading its own version, so
+ * old numbers survive later rate changes. Without a stamp the brief reads
+ * the legacy version.
+ */
+
+export const LEGACY_RATES_VERSION = 1;
+export const CURRENT_RATES_VERSION = 2;
+
+const STAMP_KEY = "tripal-rates-stamp";
+
+const canUseStorage = (): boolean =>
+  typeof window !== "undefined" && typeof window.localStorage !== "undefined";
+
+const readStamp = (): RateStamp | null => {
+  if (!canUseStorage()) return null;
+  try {
+    const raw = window.localStorage.getItem(STAMP_KEY);
+    if (raw === null) return null;
+    const parsed = JSON.parse(raw) as Record<string, unknown>;
+    if (typeof parsed !== "object" || parsed === null) return null;
+    if (typeof parsed.briefId !== "string" || typeof parsed.stampedAt !== "string") return null;
+    if (typeof parsed.version !== "number" || !Number.isFinite(parsed.version)) return null;
+    return { briefId: parsed.briefId, version: parsed.version, stampedAt: parsed.stampedAt };
+  } catch {
+    return null;
+  }
+};
+
+const writeStamp = (stamp: RateStamp): boolean => {
+  if (!canUseStorage()) return false;
+  try {
+    window.localStorage.setItem(STAMP_KEY, JSON.stringify(stamp));
+    return true;
+  } catch {
+    return false;
+  }
+};
+
+/** Today's catalog numbers as a versioned table. */
+export const snapshotRates = (): RateTable => ({
+  ...todayRates(),
+  version: CURRENT_RATES_VERSION,
+});
+
+/** Finds a table by version in the known history. */
+export const tableFor = (history: RateTable[], version: number): RateTable | null =>
+  history.find((table) => table.version === version) ?? null;
+
+export const getStampedVersion = ():
+  | { ok: true; version: number }
+  | { ok: false; reason: "storage-unavailable"; message: string } => {
+  if (!canUseStorage()) {
+    return { ok: false, reason: "storage-unavailable", message: "The rate stamp is not accessible." };
+  }
+  const stamp = readStamp();
+  return { ok: true, version: stamp === null ? LEGACY_RATES_VERSION : stamp.version };
+};
+
+export const stampRates = (
+  briefId: string,
+  version: number,
+  history: RateTable[],
+): { ok: true; stamp: RateStamp } | { ok: false; reason: "version-unknown" | "storage-unavailable"; message: string } => {
+  if (!canUseStorage()) {
+    return { ok: false, reason: "storage-unavailable", message: "The rate stamp is not accessible." };
+  }
+  if (tableFor(history, version) === null) {
+    return { ok: false, reason: "version-unknown", message: `No rate table carries version ${version}.` };
+  }
+  const stamp: RateStamp = { briefId, version, stampedAt: new Date().toISOString() };
+  if (!writeStamp(stamp)) {
+    return { ok: false, reason: "storage-unavailable", message: "The rate stamp could not be saved." };
+  }
+  return { ok: true, stamp };
+};
+
+/** The estimate for a brief computed under one specific rate table. */
+export const estimateAtRates = (brief: ProjectBrief, table: RateTable): BriefEstimate =>
+  createEstimate(brief, { services: table.services, deliverables: table.deliverables });
+
+export const ratesGap = (
+  brief: ProjectBrief,
+  history: RateTable[],
+):
+  | { ok: true; gap: RatesGap }
+  | { ok: false; reason: "version-unknown" | "storage-unavailable"; message: string } => {
+  if (!canUseStorage()) {
+    return { ok: false, reason: "storage-unavailable", message: "The rate stamp is not accessible." };
+  }
+  const stamp = readStamp();
+  const versionThen = stamp === null ? LEGACY_RATES_VERSION : stamp.version;
+  const then = tableFor(history, versionThen);
+  if (then === null) {
+    return { ok: false, reason: "version-unknown", message: `No rate table carries version ${versionThen}.` };
+  }
+  const versionNow = history.reduce((newest, table) => Math.max(newest, table.version), 0);
+  const now = tableFor(history, versionNow);
+  if (now === null) {
+    return { ok: false, reason: "version-unknown", message: `No rate table carries version ${versionNow}.` };
+  }
+  const original = estimateAtRates(brief, then);
+  const current = estimateAtRates(brief, now);
+  const changedLines = original.lines
+    .filter((line) => line.hours !== current.lines.find((candidate) => candidate.id === line.id)?.hours)
+    .map((line) => ({
+      id: line.id,
+      name: line.name,
+      hoursThen: line.hours,
+      hoursNow: current.lines.find((candidate) => candidate.id === line.id)?.hours ?? line.hours,
+    }));
+  return {
+    ok: true,
+    gap: {
+      versionThen,
+      versionNow,
+      hoursThen: original.estimatedHours,
+      hoursNow: current.estimatedHours,
+      minThen: original.minCost,
+      minNow: current.minCost,
+      maxThen: original.maxCost,
+      maxNow: current.maxCost,
+      changedLines,
+    },
+  };
+};
