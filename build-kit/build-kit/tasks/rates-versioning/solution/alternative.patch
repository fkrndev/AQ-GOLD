+"use client";
+
+import { buildRatesGapText } from "./export";
+import { getStampedVersion, ratesGap, snapshotRates } from "./rates";
+import type { ProjectBrief, RateTable } from "./types";
+
+export type RatesFootnoteProps = {
+  brief: ProjectBrief;
+};
+
+const rateHistory = (): RateTable[] => {
+  const current = snapshotRates();
+  return [
+    { ...current, version: 1 },
+    current,
+  ];
+};
+
+export function RatesFootnote({ brief }: RatesFootnoteProps) {
+  const stamped = getStampedVersion();
+  const report = ratesGap(brief, rateHistory());
+
+  return (
+    <aside className="brief-rates-footnote">
+      <p className="brief-rates-footnote__version">
+        Estimated under rate version {stamped.ok ? stamped.version : "unknown"}
+      </p>
+      {report.ok ? (
+        <p className="brief-rates-footnote__gap">{buildRatesGapText(report.gap)}</p>
+      ) : (
+        <p className="brief-rates-footnote__gap">{report.message}</p>
+      )}
+    </aside>
+  );
+}
