+"use client";
+
+import { useState } from "react";
+import { buildLifecycleText } from "./export";
+import { getTrail, transitionBrief } from "./lifecycle";
+import type { LifecycleEvent, LifecycleStatus } from "./types";
+
+export type StatusStripProps = {
+  current: LifecycleStatus;
+  history: LifecycleEvent[];
+  lockedHours: number | null;
+  onPhase: (current: LifecycleStatus, history: LifecycleEvent[]) => void;
+  onMessage: (text: string) => void;
+};
+
+const STEP_WORDS: Record<LifecycleStatus, string> = {
+  draft: "review",
+  "in-review": "ready",
+  ready: "sign off",
+  "signed-off": "",
+};
+
+export function StatusStrip({ current, history, lockedHours, onPhase, onMessage }: StatusStripProps) {
+  const [unlockText, setUnlockText] = useState("");
+
+  const run = (target: LifecycleStatus, carried: string) => {
+    const outcome = transitionBrief(target, carried);
+    if (!outcome.ok) {
+      onMessage(outcome.message);
+      return;
+    }
+    const log = getTrail();
+    onPhase(outcome.status, log.ok ? log.events : []);
+    onMessage("");
+    setUnlockText("");
+  };
+
+  return (
+    <aside className="brief-status-strip">
+      <p className="brief-status-strip__phase">Phase: <strong>{current}</strong></p>
+      {current === "signed-off" ? (
+        <div className="brief-status-strip__unlock">
+          <label>
+            Unlock note
+            <input value={unlockText} onChange={(event) => setUnlockText(event.target.value)} />
+          </label>
+          <button type="button" onClick={() => run("draft", unlockText)}>Unlock brief</button>
+        </div>
+      ) : (
+        <button type="button" onClick={() => run(current === "draft" ? "in-review" : current === "in-review" ? "ready" : "signed-off", "")}>
+          Move to {STEP_WORDS[current]}
+        </button>
+      )}
+      {lockedHours === null ? null : <p className="brief-status-strip__locked">Locked at {lockedHours} hours.</p>}
+      <p className="brief-status-strip__log">{buildLifecycleText(history)}</p>
+    </aside>
+  );
+}
