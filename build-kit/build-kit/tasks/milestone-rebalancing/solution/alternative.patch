+"use client";
+
+import type { EstimateMilestone } from "./types";
+
+export type PinnedMilestonesProps = {
+  plan: EstimateMilestone[];
+  pinnedIds: string[];
+  onPin: (id: string, pinned: boolean) => void;
+  onCompress: () => void;
+  note: string | null;
+  hasLaunch: boolean;
+};
+
+export function PinnedMilestones({
+  plan,
+  pinnedIds,
+  onPin,
+  onCompress,
+  note,
+  hasLaunch,
+}: PinnedMilestonesProps) {
+  return (
+    <section className="brief-pinned">
+      <h3>Working milestones</h3>
+      {hasLaunch ? (
+        <div className="brief-pinned__compress">
+          <button type="button" onClick={onCompress}>
+            Compress to launch date
+          </button>
+          {note ? <small>{note}</small> : null}
+        </div>
+      ) : null}
+      <div>
+        {plan.map((milestone) => (
+          <article key={milestone.id}>
+            <span>{milestone.paymentPercent}%</span>
+            <div>
+              <strong>{milestone.name}</strong>
+              <p>
+                {milestone.weeks} week{milestone.weeks === 1 ? "" : "s"} —{" "}
+                {milestone.description}
+              </p>
+              <small>{milestone.outputs.join(" / ")}</small>
+            </div>
+            <label className="brief-pinned__freeze">
+              <input
+                type="checkbox"
+                checked={pinnedIds.includes(milestone.id)}
+                onChange={(event) => onPin(milestone.id, event.target.checked)}
+              />
+              Freeze these weeks
+            </label>
+          </article>
+        ))}
+      </div>
+    </section>
+  );
+}
