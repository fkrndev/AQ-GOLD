+"use client";
+
+import { useState } from "react";
+import { buildLifecycleText } from "./export";
+import { getTrail, transitionBrief } from "./lifecycle";
+import type { LifecycleEvent, LifecycleStatus } from "./types";
+
+export type LifecycleControlsProps = {
+  status: LifecycleStatus;
+  events: LifecycleEvent[];
+  frozenHours: number | null;
+  onMoved: (status: LifecycleStatus, events: LifecycleEvent[]) => void;
+  onNotice: (message: string) => void;
+};
+
+const NEXT_STEP: Partial<Record<LifecycleStatus, { to: LifecycleStatus; label: string }>> = {
+  draft: { to: "in-review", label: "Send to review" },
+  "in-review": { to: "ready", label: "Mark ready" },
+  ready: { to: "signed-off", label: "Sign off" },
+};
+
+export function LifecycleControls({ status, events, frozenHours, onMoved, onNotice }: LifecycleControlsProps) {
+  const [note, setNote] = useState("");
+  const next = NEXT_STEP[status];
+
+  const move = (to: LifecycleStatus, reopenNote: string) => {
+    const result = transitionBrief(to, reopenNote);
+    if (!result.ok) {
+      onNotice(result.message);
+      return;
+    }
+    const trail = getTrail();
+    onMoved(result.status, trail.ok ? trail.events : []);
+    onNotice("");
+    setNote("");
+  };
+
+  return (
+    <section className="brief-lifecycle">
+      <h3>Brief status: {status}</h3>
+      {next ? (
+        <button type="button" onClick={() => move(next.to, "")}>
+          {next.label}
+        </button>
+      ) : (
+        <div className="brief-lifecycle__reopen">
+          <input
+            value={note}
+            placeholder="Why is this being reopened?"
+            onChange={(event) => setNote(event.target.value)}
+          />
+          <button type="button" onClick={() => move("draft", note)}>
+            Record reopen
+          </button>
+        </div>
+      )}
+      {frozenHours === null ? null : <p>Signed off at {frozenHours} hours.</p>}
+      <pre className="brief-lifecycle__trail">{buildLifecycleText(events)}</pre>
+    </section>
+  );
+}
