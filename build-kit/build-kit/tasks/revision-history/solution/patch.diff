+"use client";
+
+import type { RevisionMeta } from "./revisions";
+
+export type RevisionPanelProps = {
+  revisionName: string;
+  onNameChange: (value: string) => void;
+  onSave: () => void;
+  revisions: RevisionMeta[];
+  onRestore: (name: string) => void;
+  onDelete: (name: string) => void;
+};
+
+export function RevisionPanel({
+  revisionName,
+  onNameChange,
+  onSave,
+  revisions,
+  onRestore,
+  onDelete,
+}: RevisionPanelProps) {
+  return (
+    <section className="brief-revisions">
+      <h3>Saved revisions</h3>
+      <div className="brief-revisions__save">
+        <input
+          type="text"
+          value={revisionName}
+          onChange={(event) => onNameChange(event.target.value)}
+          placeholder="Revision name"
+        />
+        <button type="button" onClick={onSave}>
+          Save revision
+        </button>
+      </div>
+      {revisions.length > 0 ? (
+        <ul className="brief-revisions__list">
+          {revisions.map((revision) => (
+            <li key={revision.id}>
+              <span>{revision.name}</span>
+              <small>
+                {new Date(revision.savedAt).toLocaleString("en-IN", {
+                  hour: "2-digit",
+                  minute: "2-digit",
+                })}
+              </small>
+              <div>
+                <button type="button" onClick={() => onRestore(revision.name)}>
+                  Restore
+                </button>
+                <button type="button" onClick={() => onDelete(revision.name)}>
+                  Delete
+                </button>
+              </div>
+            </li>
+          ))}
+        </ul>
+      ) : (
+        <p className="brief-revisions__empty">No revisions saved yet.</p>
+      )}
+    </section>
+  );
+}
