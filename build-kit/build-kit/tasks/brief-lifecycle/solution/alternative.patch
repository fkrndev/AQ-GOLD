new file mode 100644
index 0000000..81d0465
--- /dev/null
+++ b/tests/lifecycle.test.ts
@@ -0,0 +1,125 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { saveBrief } from "../app/(site)/brief/storage";
+import { createEmptyBrief } from "../app/(site)/brief/defaults";
+import { buildLifecycleText } from "../app/(site)/brief/export";
+import {
+  ensureEditable,
+  getFrozenEstimate,
+  getStatus,
+  getTrail,
+  transitionBrief,
+} from "../app/(site)/brief/lifecycle";
+
+const backing = new Map<string, string>();
+const storageStub = {
+  getItem: (key: string) => backing.get(key) ?? null,
+  setItem: (key: string, value: string) => void backing.set(key, value),
+  removeItem: (key: string) => void backing.delete(key),
+  clear: () => void backing.clear(),
+  length: 0,
+  key: (_index: number) => null,
+};
+
+beforeEach(() => {
+  backing.clear();
+  vi.stubGlobal("window", { localStorage: storageStub });
+});
+
+afterEach(() => {
+  vi.unstubAllGlobals();
+});
+
+const plantBrief = () => {
+  const brief = createEmptyBrief();
+  brief.projectName = "Phase coverage";
+  saveBrief(brief);
+  return brief;
+};
+
+describe("phase machine", () => {
+  it("begins in draft", () => {
+    plantBrief();
+    expect(getStatus()).toBe("draft");
+  });
+
+  it("walks the full path to signed off", () => {
+    plantBrief();
+    expect(transitionBrief("in-review").ok).toBe(true);
+    expect(transitionBrief("ready").ok).toBe(true);
+    expect(transitionBrief("signed-off").ok).toBe(true);
+    expect(getStatus()).toBe("signed-off");
+  });
+
+  it("blocks jumping ahead", () => {
+    plantBrief();
+    const jump = transitionBrief("ready");
+    expect(jump.ok).toBe(false);
+  });
+
+  it("demands a note to unlock", () => {
+    plantBrief();
+    transitionBrief("in-review");
+    transitionBrief("ready");
+    transitionBrief("signed-off");
+    expect(transitionBrief("draft").ok).toBe(false);
+    expect(transitionBrief("draft", "pricing reopened").ok).toBe(true);
+  });
+});
+
+describe("phase log", () => {
+  it("grows by one entry per move", () => {
+    plantBrief();
+    transitionBrief("in-review");
+    transitionBrief("ready");
+    const log = getTrail();
+    expect(log.ok && log.events.length === 2).toBe(true);
+  });
+
+  it("keeps the unlock note on the record", () => {
+    plantBrief();
+    transitionBrief("in-review");
+    transitionBrief("ready");
+    transitionBrief("signed-off");
+    transitionBrief("draft", "scope widened");
+    const log = getTrail();
+    if (!log.ok) return;
+    const final = log.events[log.events.length - 1];
+    expect(final.note).toBe("scope widened");
+  });
+
+  it("renders each move as a line", () => {
+    plantBrief();
+    transitionBrief("in-review");
+    const log = getTrail();
+    if (!log.ok) return;
+    expect(buildLifecycleText(log.events)).toBe("start -> in-review");
+  });
+
+  it("says so when nothing has happened yet", () => {
+    expect(buildLifecycleText([])).toBe("No lifecycle moves");
+  });
+});
+
+describe("locked numbers", () => {
+  it("locks only at sign off", () => {
+    plantBrief();
+    transitionBrief("in-review");
+    expect(getFrozenEstimate().ok).toBe(false);
+    transitionBrief("ready");
+    transitionBrief("signed-off");
+    expect(getFrozenEstimate().ok).toBe(true);
+  });
+});
+
+describe("edit lock", () => {
+  it("open while drafting, shut once signed off, open after unlock", () => {
+    plantBrief();
+    expect(ensureEditable().ok).toBe(true);
+    transitionBrief("in-review");
+    transitionBrief("ready");
+    transitionBrief("signed-off");
+    expect(ensureEditable().ok).toBe(false);
+    transitionBrief("draft", "client edit round");
+    expect(ensureEditable().ok).toBe(true);
+  });
+});
