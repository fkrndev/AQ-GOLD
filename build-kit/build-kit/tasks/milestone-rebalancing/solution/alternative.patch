+import { describe, expect, it } from "vitest";
+import {
+  compressForLaunch,
+  rebalanceMilestones,
+  weeksUntil,
+} from "../app/(site)/brief/rebalance";
+import { createEstimate, estimateWithTimeline } from "../app/(site)/brief/estimate";
+import type { EstimateMilestone } from "../app/(site)/brief/types";
+import { makeBrief, service } from "./helpers";
+
+const milestone = (
+  id: string,
+  weeks: number,
+  paymentPercent: number,
+): EstimateMilestone => ({
+  id,
+  name: id,
+  weeks,
+  description: `${id} work`,
+  outputs: [`${id} output`],
+  paymentPercent,
+});
+
+const plan = (): EstimateMilestone[] => [
+  milestone("align", 3, 30),
+  milestone("direction", 4, 30),
+  milestone("develop", 5, 25),
+  milestone("launch", 2, 15),
+];
+
+const totalWeeks = (milestones: EstimateMilestone[]): number =>
+  milestones.reduce((total, item) => total + item.weeks, 0);
+
+const totalPayment = (milestones: EstimateMilestone[]): number =>
+  milestones.reduce((total, item) => total + item.paymentPercent, 0);
+
+describe("rebalanceMilestones", () => {
+  it("keeps locked weeks and payment shares while the rest absorb the change", () => {
+    const outcome = rebalanceMilestones(plan(), { totalWeeks: 10, lockedIds: ["develop"] });
+    expect(outcome.ok).toBe(true);
+    if (!outcome.ok) return;
+    const develop = outcome.milestones.find((item) => item.id === "develop");
+    expect(develop?.weeks).toBe(5);
+    expect(develop?.paymentPercent).toBe(25);
+    expect(totalWeeks(outcome.milestones)).toBe(10);
+    expect(totalPayment(outcome.milestones)).toBe(100);
+  });
+
+  it("gives every unlocked milestone at least one week and one percent", () => {
+    const outcome = rebalanceMilestones(plan(), { totalWeeks: 5 });
+    expect(outcome.ok).toBe(true);
+    if (!outcome.ok) return;
+    expect(outcome.milestones.every((item) => item.weeks >= 1)).toBe(true);
+    expect(outcome.milestones.every((item) => item.paymentPercent >= 1)).toBe(true);
+    expect(totalWeeks(outcome.milestones)).toBe(5);
+    expect(totalPayment(outcome.milestones)).toBe(100);
+  });
+
+  it("returns an unchanged plan when the total already fits and nothing is locked", () => {
+    const outcome = rebalanceMilestones(plan(), { totalWeeks: 14 });
+    expect(outcome.ok).toBe(true);
+    if (!outcome.ok) return;
+    expect(outcome.milestones).toEqual(plan());
+  });
+
+  it("never mutates the input plan", () => {
+    const original = plan();
+    rebalanceMilestones(original, { totalWeeks: 8, lockedIds: ["align"] });
+    expect(original).toEqual(plan());
+  });
+
+  it("is deterministic for repeated runs", () => {
+    const first = rebalanceMilestones(plan(), { totalWeeks: 9, lockedIds: ["direction"] });
+    const second = rebalanceMilestones(plan(), { totalWeeks: 9, lockedIds: ["direction"] });
+    expect(first).toEqual(second);
+  });
+
+  it("ignores lock ids that do not exist in the plan", () => {
+    const outcome = rebalanceMilestones(plan(), { totalWeeks: 12, lockedIds: ["ghost"] });
+    expect(outcome.ok).toBe(true);
+    if (!outcome.ok) return;
+    expect(totalWeeks(outcome.milestones)).toBe(12);
+  });
+
+  it("refuses totals that are not whole positive numbers", () => {
+    for (const bad of [0, -3, 4.5, Number.NaN]) {
+      const outcome = rebalanceMilestones(plan(), { totalWeeks: bad });
+      expect(outcome.ok).toBe(false);
+      if (outcome.ok) continue;
+      expect(outcome.reason).toBe("invalid-total");
+      expect(outcome.releaseCandidates).toEqual([]);
+    }
+  });
+
+  it("names the lock to release when pins leave too little room", () => {
+    const tight = [
+      milestone("align", 6, 50),
+      milestone("direction", 6, 40),
+      milestone("develop", 1, 5),
+      milestone("launch", 1, 5),
+    ];
+    const outcome = rebalanceMilestones(tight, { totalWeeks: 9, lockedIds: ["align", "direction"] });
+    expect(outcome.ok).toBe(false);
+    if (outcome.ok) return;
+    expect(outcome.reason).toBe("unsatisfiable");
+    expect(outcome.releaseCandidates.length).toBeGreaterThan(0);
+    expect(["align", "direction"]).toContain(outcome.releaseCandidates[0]);
+
+    // releasing the named lock makes the same request feasible
+    const retry = rebalanceMilestones(tight, {
+      totalWeeks: 9,
+      lockedIds: ["align", "direction"].filter((id) => !outcome.releaseCandidates.includes(id)),
+    });
+    expect(retry.ok).toBe(true);
+  });
+
+  it("refuses a timeline shorter than one week per milestone with no candidates", () => {
+    const outcome = rebalanceMilestones(plan(), { totalWeeks: 3 });
+    expect(outcome.ok).toBe(false);
+    if (outcome.ok) return;
+    expect(outcome.reason).toBe("unsatisfiable");
+    expect(outcome.releaseCandidates).toEqual([]);
+  });
+});
+
+describe("weeksUntil", () => {
+  it("counts whole weeks between dates, rounding down", () => {
+    expect(weeksUntil("2026-01-05", "2026-02-02")).toBe(4);
+    expect(weeksUntil("2026-01-05", "2026-02-01")).toBe(3);
+    expect(weeksUntil("2026-01-05", "2026-01-04")).toBe(0);
+  });
+});
+
+describe("compressForLaunch", () => {
+  it("returns the plan unchanged when it already fits", () => {
+    const outcome = compressForLaunch(plan(), "2026-01-05", "2026-04-14");
+    expect(outcome.ok).toBe(true);
+    if (!outcome.ok) return;
+    expect(outcome.milestones).toEqual(plan());
+  });
+
+  it("compresses to the available weeks while respecting locks", () => {
+    const outcome = compressForLaunch(plan(), "2026-01-05", "2026-02-09", ["launch"]);
+    expect(outcome.ok).toBe(true);
+    if (!outcome.ok) return;
+    expect(totalWeeks(outcome.milestones)).toBe(5);
+    expect(outcome.milestones.find((item) => item.id === "launch")?.weeks).toBe(2);
+    expect(totalPayment(outcome.milestones)).toBe(100);
+    expect(outcome.milestones.find((item) => item.id === "launch")?.paymentPercent).toBe(15);
+  });
+
+  it("refuses a launch date that leaves no whole weeks", () => {
+    const outcome = compressForLaunch(plan(), "2026-02-02", "2026-01-05");
+    expect(outcome.ok).toBe(false);
+    if (outcome.ok) return;
+    expect(outcome.reason).toBe("unsatisfiable");
+  });
+});
+
+
+describe("estimateWithTimeline", () => {
+  it("fits the estimated plan onto the requested timeline", () => {
+    const brief = makeBrief({
+      selectedServices: [service("research"), service("brand-strategy")],
+      timelineRange: "six-to-ten",
+    });
+    const estimate = createEstimate(brief);
+    const outcome = estimateWithTimeline(brief, { totalWeeks: Math.max(4, estimate.estimatedWeeks) });
+    expect(outcome.ok).toBe(true);
+    if (!outcome.ok) return;
+    const weeks = outcome.estimate.milestones.reduce((total, item) => total + item.weeks, 0);
