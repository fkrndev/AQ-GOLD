+"use client";
+
+import type { RevisionMeta } from "./revisions";
+
+export type SnapshotListProps = {
+  label: string;
+  onLabelChange: (value: string) => void;
+  onCommit: () => void;
+  entries: RevisionMeta[];
+  onRevert: (name: string) => void;
+  onRemove: (name: string) => void;
+};
+
+export function SnapshotList({
+  label,
+  onLabelChange,
+  onCommit,
+  entries,
+  onRevert,
+  onRemove,
+}: SnapshotListProps) {
+  return (
+    <section className="brief-history">
+      <h3>History</h3>
+      <div className="brief-history__save">
+        <input
+          type="text"
+          value={label}
+          onChange={(event) => onLabelChange(event.target.value)}
+          placeholder="Snapshot label"
+        />
+        <button type="button" onClick={onCommit}>
+          Snapshot
+        </button>
+      </div>
+      {entries.length > 0 ? (
+        <ul className="brief-history__list">
+          {entries.map((entry) => (
+            <li key={entry.id}>
+              <span>{entry.name}</span>
+              <small>
+                {new Date(entry.savedAt).toLocaleString("en-IN", {
+                  hour: "2-digit",
+                  minute: "2-digit",
+                })}
+              </small>
+              <div>
+                <button type="button" onClick={() => onRevert(entry.name)}>
+                  Revert
+                </button>
+                <button type="button" onClick={() => onRemove(entry.name)}>
+                  Remove
+                </button>
+              </div>
+            </li>
+          ))}
+        </ul>
+      ) : (
+        <p className="brief-history__empty">No snapshots yet.</p>
+      )}
+    </section>
+  );
+}
