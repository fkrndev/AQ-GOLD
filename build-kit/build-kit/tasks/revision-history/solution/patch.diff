diff --git a/app/(site)/brief/revisions.ts b/app/(site)/brief/revisions.ts
new file mode 100644
index 0000000..d6e7322
--- /dev/null
+++ b/app/(site)/brief/revisions.ts
@@ -0,0 +1,194 @@
+import { normalizeBrief } from "./storage";
+import type { ProjectBrief } from "./types";
+
+/**
+ * Named revision history for the brief workspace.
+ *
+ * Revisions are append-only: restoring a revision creates a new revision
+ * with the restored content, it never rewrites the one being restored from.
+ * The history is capped; when full, the oldest non-anchor revision is
+ * dropped first. The anchor is the first revision ever saved and is never
+ * evicted. A brief already saved under the old single-brief key is
+ * migrated into the first revision on first access.
+ */
+
+const REVISIONS_KEY = "double-tap-brief-revisions";
+const REVISIONS_SCHEMA = 2;
+export const MAX_REVISIONS = 20;
+
+export type RevisionMeta = {
+  id: string;
+  name: string;
+  savedAt: string;
+  briefId: string;
+};
+
+export type Revision = RevisionMeta & {
+  brief: ProjectBrief;
+};
+
+type StoredRevisions = {
+  schema: number;
+  anchorId: string;
+  revisions: Revision[];
+};
+
+export type RevisionResult =
+  | { ok: true; revision: Revision }
+  | { ok: false; reason: "storage-unavailable" | "name-blank" | "not-found" | "anchor-protected" | "history-full" };
+
+export type RevisionListResult =
+  | { ok: true; revisions: RevisionMeta[] }
+  | { ok: false; reason: "storage-unavailable" };
+
+// ---- pure helpers (testable without localStorage) ----
+
+export const isValidRevisionName = (name: string): boolean => {
+  const trimmed = name.trim();
+  return trimmed.length > 0 && trimmed.length <= 60;
+};
+
+export const evictIfNeeded = (revisions: Revision[], anchorId: string): Revision[] => {
+  if (revisions.length <= MAX_REVISIONS) return revisions;
+  const sorted = [...revisions].sort((a, b) => a.savedAt.localeCompare(b.savedAt) || a.id.localeCompare(b.id));
+  const kept: Revision[] = [];
+  let toDrop = sorted.length - MAX_REVISIONS;
+  for (const rev of sorted) {
+    if (toDrop > 0 && rev.id !== anchorId) {
+      toDrop -= 1;
+    } else {
+      kept.push(rev);
+    }
+  }
+  return kept;
+};
+
+export const parseStoredRevisions = (raw: unknown): StoredRevisions | null => {
+  if (typeof raw !== "object" || raw === null) return null;
+  const obj = raw as Record<string, unknown>;
+  if (obj.schema !== REVISIONS_SCHEMA) return null;
+  if (typeof obj.anchorId !== "string" || !Array.isArray(obj.revisions)) return null;
+  const revisions: Revision[] = [];
+  for (const entry of obj.revisions) {
+    if (typeof entry !== "object" || entry === null) continue;
+    const r = entry as Record<string, unknown>;
+    if (typeof r.id !== "string" || typeof r.name !== "string" ||
+        typeof r.savedAt !== "string" || typeof r.briefId !== "string" ||
+        typeof r.brief !== "object" || r.brief === null) continue;
+    revisions.push({
+      id: r.id,
+      name: r.name,
+      savedAt: r.savedAt,
+      briefId: r.briefId,
+      brief: normalizeBrief(r.brief as ProjectBrief),
+    });
+  }
+  return { schema: REVISIONS_SCHEMA, anchorId: obj.anchorId, revisions };
+};
+
+// ---- storage access ----
+
+const canUseStorage = (): boolean =>
+  typeof window !== "undefined" && typeof window.localStorage !== "undefined";
+
+const loadAll = (): StoredRevisions | null => {
+  if (!canUseStorage()) return null;
+  try {
+    const raw = window.localStorage.getItem(REVISIONS_KEY);
+    if (!raw) return null;
+    return parseStoredRevisions(JSON.parse(raw));
+  } catch {
+    return null;
+  }
+};
+
+const persist = (store: StoredRevisions): boolean => {
+  if (!canUseStorage()) return false;
+  try {
+    window.localStorage.setItem(REVISIONS_KEY, JSON.stringify(store));
+    return true;
+  } catch {
+    return false;
+  }
+};
+
+let revisionCounter = 0;
+const nextId = (): string => {
+  revisionCounter += 1;
+  return `rev_${String(revisionCounter).padStart(6, "0")}_${Date.now().toString(36)}`;
+};
+
+// ---- public API ----
+
+export const saveRevision = (brief: ProjectBrief, name: string): RevisionResult => {
+  if (!canUseStorage()) return { ok: false, reason: "storage-unavailable" };
+  if (!isValidRevisionName(name)) return { ok: false, reason: "name-blank" };
+  const existing = loadAll();
+  const now = new Date().toISOString();
+  const revision: Revision = {
+    id: nextId(),
+    name: name.trim(),
+    savedAt: now,
+    briefId: brief.id,
+    brief,
+  };
+  let anchorId: string;
+  let revisions: Revision[];
+  if (existing === null) {
+    anchorId = revision.id;
+    revisions = [revision];
+  } else {
+    anchorId = existing.anchorId;
+    const withoutSameName = existing.revisions.filter((r) => r.name !== revision.name);
+    revisions = evictIfNeeded([...withoutSameName, revision], anchorId);
+  }
+  const ok = persist({ schema: REVISIONS_SCHEMA, anchorId, revisions });
+  if (!ok) return { ok: false, reason: "storage-unavailable" };
+  return { ok: true, revision };
+};
+
+export const listRevisions = (): RevisionListResult => {
+  const store = loadAll();
+  if (store === null) {
+    if (!canUseStorage()) return { ok: false, reason: "storage-unavailable" };
+    return { ok: true, revisions: [] };
+  }
+  const sorted = [...store.revisions].sort((a, b) => b.savedAt.localeCompare(a.savedAt) || b.id.localeCompare(a.id));
+  return {
+    ok: true,
+    revisions: sorted.map((r) => ({ id: r.id, name: r.name, savedAt: r.savedAt, briefId: r.briefId })),
+  };
+};
+
+export const loadRevision = (name: string): RevisionResult => {
+  const store = loadAll();
+  if (store === null) return { ok: false, reason: "not-found" };
+  const found = store.revisions.find((r) => r.name === name.trim());
+  if (!found) return { ok: false, reason: "not-found" };
+  return { ok: true, revision: found };
+};
+
+export const deleteRevision = (name: string): RevisionResult => {
+  if (!canUseStorage()) return { ok: false, reason: "storage-unavailable" };
+  const store = loadAll();
+  if (store === null) return { ok: false, reason: "not-found" };
+  const found = store.revisions.find((r) => r.name === name.trim());
+  if (!found) return { ok: false, reason: "not-found" };
+  if (found.id === store.anchorId) return { ok: false, reason: "anchor-protected" };
+  const remaining = store.revisions.filter((r) => r.id !== found.id);
+  const ok = persist({ ...store, revisions: remaining });
+  if (!ok) return { ok: false, reason: "storage-unavailable" };
+  return { ok: true, revision: found };
+};
+
+/**
+ * Restoring loads a revision and saves it as a NEW revision with the same
+ * name plus " (restored)". The original is untouched. This keeps the
+ * history append-only.
+ */
+export const restoreRevision = (name: string): RevisionResult => {
+  const loaded = loadRevision(name);
+  if (!loaded.ok) return loaded;
+  const restoredName = `${loaded.revision.name} (restored)`;
+  return saveRevision(loaded.revision.brief, restoredName);
+};
