diff --git a/app/(site)/brief/revisions.ts b/app/(site)/brief/revisions.ts
new file mode 100644
index 0000000..2ca5f86
--- /dev/null
+++ b/app/(site)/brief/revisions.ts
@@ -0,0 +1,254 @@
+import { normalizeBrief } from "./storage";
+import type { ProjectBrief } from "./types";
+
+/**
+ * Named revision history for the brief workspace, kept as one storage slot
+ * per revision plus a small index. Every write rebuilds the index and
+ * deletes the slots of any revision that fell out of the history, so
+ * storage never keeps data the list no longer shows.
+ */
+
+export const MAX_REVISIONS = 20;
+
+export type RevisionMeta = {
+  id: string;
+  name: string;
+  savedAt: string;
+  briefId: string;
+};
+
+export type Revision = RevisionMeta & {
+  brief: ProjectBrief;
+};
+
+export type RevisionResult =
+  | { ok: true; revision: Revision }
+  | { ok: false; reason: "storage-unavailable" | "name-blank" | "not-found" | "anchor-protected" | "history-full" };
+
+export type RevisionListResult =
+  | { ok: true; revisions: RevisionMeta[] }
+  | { ok: false; reason: "storage-unavailable" };
+
+const INDEX_KEY = "double-tap-revision-index";
+const SLOT_PREFIX = "double-tap-rev-";
+
+type IndexEntry = { id: string; key: string };
+
+type Index = {
+  anchorId: string;
+  entries: IndexEntry[];
+};
+
+const storageAlive = (): boolean => {
+  if (typeof window === "undefined") return false;
+  try {
+    void window.localStorage.length;
+    return true;
+  } catch {
+    return false;
+  }
+};
+
+const cleanName = (name: string): string | null => {
+  const label = name.trim();
+  return label.length === 0 || label.length > 60 ? null : label;
+};
+
+let minted = 0;
+const mintId = (): string => {
+  minted += 1;
+  return `r-${Date.now().toString(36)}-${String(minted).padStart(4, "0")}`;
+};
+
+const readSlot = (slot: string): Revision | null => {
+  try {
+    const raw = window.localStorage.getItem(SLOT_PREFIX + slot);
+    if (raw === null) return null;
+    const parsed = JSON.parse(raw) as Record<string, unknown>;
+    if (typeof parsed !== "object" || parsed === null) return null;
+    if (
+      typeof parsed.id !== "string" ||
+      typeof parsed.name !== "string" ||
+      typeof parsed.savedAt !== "string" ||
+      typeof parsed.briefId !== "string" ||
+      typeof parsed.brief !== "object" ||
+      parsed.brief === null
+    ) {
+      return null;
+    }
+    return {
+      id: parsed.id,
+      name: parsed.name,
+      savedAt: parsed.savedAt,
+      briefId: parsed.briefId,
+      brief: normalizeBrief(parsed.brief as ProjectBrief),
+    };
+  } catch {
+    return null;
+  }
+};
+
+const writeSlot = (revision: Revision): boolean => {
+  try {
+    window.localStorage.setItem(SLOT_PREFIX + revision.id, JSON.stringify(revision));
+    return true;
+  } catch {
+    return false;
+  }
+};
+
+const dropSlot = (id: string): void => {
+  try {
+    window.localStorage.removeItem(SLOT_PREFIX + id);
+  } catch {
+    // A slot that cannot be removed is ignored; the index is the truth.
+  }
+};
+
+const loadIndex = (): Index | null => {
+  try {
+    const raw = window.localStorage.getItem(INDEX_KEY);
+    if (raw === null) return null;
+    const parsed = JSON.parse(raw) as Record<string, unknown>;
+    if (typeof parsed !== "object" || parsed === null) return null;
+    if (typeof parsed.anchorId !== "string" || !Array.isArray(parsed.entries)) return null;
+    const entries: IndexEntry[] = [];
+    for (const item of parsed.entries) {
+      if (typeof item !== "object" || item === null) continue;
+      const entry = item as Record<string, unknown>;
+      if (typeof entry.id !== "string" || typeof entry.key !== "string") continue;
+      entries.push({ id: entry.id, key: entry.key });
+    }
+    return { anchorId: parsed.anchorId, entries };
+  } catch {
+    return null;
+  }
+};
+
+const saveIndex = (index: Index): boolean => {
+  try {
+    window.localStorage.setItem(INDEX_KEY, JSON.stringify(index));
+    return true;
+  } catch {
+    return false;
+  }
+};
+
+/** Splits into what stays and what goes, counting only non-anchor drops. */
+const splitForLimit = (revisions: Revision[], anchorId: string): { kept: Revision[]; dropped: Revision[] } => {
+  const byAge = [...revisions].sort((a, b) => a.savedAt.localeCompare(b.savedAt) || a.id.localeCompare(b.id));
+  const spare = byAge.length - MAX_REVISIONS;
+  const droppedIds = new Set<string>();
+  let budget = spare > 0 ? spare : 0;
+  for (const candidate of byAge) {
+    if (budget > 0 && candidate.id !== anchorId) {
+      droppedIds.add(candidate.id);
+      budget -= 1;
+    }
+  }
+  return {
+    kept: revisions.filter((revision) => !droppedIds.has(revision.id)),
+    dropped: revisions.filter((revision) => droppedIds.has(revision.id)),
+  };
+};
+
+const collectAll = (index: Index): Revision[] => {
+  const loaded: Revision[] = [];
+  for (const entry of index.entries) {
+    const revision = readSlot(entry.key);
+    if (revision !== null) loaded.push(revision);
+  }
+  return loaded;
+};
+
+export const saveRevision = (brief: ProjectBrief, name: string): RevisionResult => {
+  if (!storageAlive()) return { ok: false, reason: "storage-unavailable" };
+  const label = cleanName(name);
+  if (label === null) return { ok: false, reason: "name-blank" };
+
+  const index = loadIndex();
+  const revision: Revision = {
+    id: mintId(),
+    name: label,
+    savedAt: new Date().toISOString(),
+    briefId: brief.id,
+    brief,
+  };
+
+  let anchorId: string;
+  let all: Revision[];
+  if (index === null) {
+    anchorId = revision.id;
+    all = [];
+  } else {
+    anchorId = index.anchorId;
+    all = collectAll(index);
+  }
+  const existing = all.filter((current) => current.name !== label);
+
+  const { kept } = splitForLimit([...existing, revision], anchorId);
+  if (!writeSlot(revision)) return { ok: false, reason: "storage-unavailable" };
+
+  // Slots for revisions that left the list (same-name replacement or
+  // eviction) are deleted so storage matches what listRevisions shows.
+  const keptIds = new Set(kept.map((current) => current.id));
+  for (const current of all) {
+    if (!keptIds.has(current.id)) dropSlot(current.id);
+  }
+
+  if (!saveIndex({ anchorId, entries: kept.map((current) => ({ id: current.id, key: current.id })) })) {
+    return { ok: false, reason: "storage-unavailable" };
+  }
+  return { ok: true, revision };
+};
+
+export const listRevisions = (): RevisionListResult => {
+  if (!storageAlive()) return { ok: false, reason: "storage-unavailable" };
+  const index = loadIndex();
+  if (index === null) return { ok: true, revisions: [] };
+  const newestFirst = [...collectAll(index)].sort(
+    (a, b) => b.savedAt.localeCompare(a.savedAt) || b.id.localeCompare(a.id),
+  );
+  return {
+    ok: true,
+    revisions: newestFirst.map(({ id, name, savedAt, briefId }) => ({ id, name, savedAt, briefId })),
+  };
+};
+
+export const loadRevision = (name: string): RevisionResult => {
+  if (!storageAlive()) return { ok: false, reason: "storage-unavailable" };
+  const index = loadIndex();
+  if (index === null) return { ok: false, reason: "not-found" };
+  const wanted = name.trim();
+  for (const entry of index.entries) {
+    const revision = readSlot(entry.key);
+    if (revision !== null && revision.name === wanted) return { ok: true, revision };
+  }
+  return { ok: false, reason: "not-found" };
+};
+
+export const deleteRevision = (name: string): RevisionResult => {
+  if (!storageAlive()) return { ok: false, reason: "storage-unavailable" };
+  const index = loadIndex();
+  if (index === null) return { ok: false, reason: "not-found" };
+  const wanted = name.trim();
+  for (const entry of index.entries) {
+    const revision = readSlot(entry.key);
+    if (revision !== null && revision.name === wanted) {
+      if (revision.id === index.anchorId) return { ok: false, reason: "anchor-protected" };
+      dropSlot(revision.id);
+      const remaining = index.entries.filter((current) => current.id !== revision.id);
+      if (!saveIndex({ anchorId: index.anchorId, entries: remaining })) {
+        return { ok: false, reason: "storage-unavailable" };
+      }
+      return { ok: true, revision };
+    }
+  }
+  return { ok: false, reason: "not-found" };
+};
+
+export const restoreRevision = (name: string): RevisionResult => {
+  const loaded = loadRevision(name);
+  if (!loaded.ok) return loaded;
+  return saveRevision(loaded.revision.brief, `${loaded.revision.name} (restored)`);
+};
