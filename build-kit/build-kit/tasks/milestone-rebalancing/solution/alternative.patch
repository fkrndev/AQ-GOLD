diff --git a/app/(site)/brief/rebalance.ts b/app/(site)/brief/rebalance.ts
new file mode 100644
index 0000000..fb32359
--- /dev/null
+++ b/app/(site)/brief/rebalance.ts
@@ -0,0 +1,186 @@
+import type { EstimateMilestone } from "./types";
+
+export type RebalanceRequest = {
+  totalWeeks: number;
+  lockedIds?: string[];
+};
+
+export type RebalanceSuccess = {
+  ok: true;
+  milestones: EstimateMilestone[];
+};
+
+export type RebalanceFailure = {
+  ok: false;
+  reason: "invalid-total" | "unsatisfiable";
+  message: string;
+  releaseCandidates: string[];
+};
+
+export type RebalanceOutcome = RebalanceSuccess | RebalanceFailure;
+
+const DAY_MS = 86_400_000;
+
+export const weeksUntil = (kickoff: string, launch: string): number => {
+  const from = new Date(kickoff).getTime();
+  const to = new Date(launch).getTime();
+  if (!Number.isFinite(from) || !Number.isFinite(to) || to < from) return 0;
+  return Math.floor((to - from) / (7 * DAY_MS));
+};
+
+// ---- Alternative internals: capacity model ----
+
+type Capacity = {
+  lockedWeeks: number;
+  lockedPayment: number;
+  unlockedIds: string[];
+  minUnlockedWeeks: number;
+  minUnlockedPayment: number;
+};
+
+const measure = (plan: EstimateMilestone[], pins: Set<string>): Capacity => {
+  let lockedWeeks = 0;
+  let lockedPayment = 0;
+  const unlockedIds: string[] = [];
+  for (const m of plan) {
+    if (pins.has(m.id)) {
+      lockedWeeks += m.weeks;
+      lockedPayment += m.paymentPercent;
+    } else {
+      unlockedIds.push(m.id);
+    }
+  }
+  return {
+    lockedWeeks,
+    lockedPayment,
+    unlockedIds,
+    minUnlockedWeeks: unlockedIds.length,
+    minUnlockedPayment: unlockedIds.length,
+  };
+};
+
+// Try removing pins one at a time until the plan becomes feasible.
+const discoverReleasable = (
+  plan: EstimateMilestone[],
+  pins: Set<string>,
+  totalWeeks: number,
+): string[] => {
+  const candidates: string[] = [];
+  const remaining = new Set(pins);
+  while (remaining.size > 0) {
+    const cap = measure(plan, remaining);
+    if (cap.lockedWeeks + cap.minUnlockedWeeks <= totalWeeks &&
+        cap.lockedPayment + cap.minUnlockedPayment <= 100) {
+      break;
+    }
+    // Remove the pin with the largest weeks (ties: first in plan order)
+    let heaviest: string | null = null;
+    let heaviestWeeks = -1;
+    for (const m of plan) {
+      if (remaining.has(m.id) && m.weeks > heaviestWeeks) {
+        heaviest = m.id;
+        heaviestWeeks = m.weeks;
+      }
+    }
+    if (heaviest === null) break;
+    candidates.push(heaviest);
+    remaining.delete(heaviest);
+  }
+  return candidates;
+};
+
+// Top-down: give each unlocked milestone a proportional share, then adjust
+// downward or upward one unit at a time to hit the target exactly.
+const cumulativeRounding = (target: number, weights: number[]): number[] => {
+  const n = weights.length;
+  if (n === 0) return [];
+  const shares = new Array<number>(n).fill(1);
+  const remaining = target - n;
+  if (remaining <= 0) return shares;
+  const total = weights.reduce((t, w) => t + Math.max(0, w), 0);
+  if (total <= 0) {
+    const per = Math.floor(remaining / n);
+    for (let i = 0; i < n; i++) shares[i] += per;
+    let extra = remaining - per * n;
+    for (let i = 0; extra > 0 && i < n; i++, extra--) shares[i] += 1;
+    return shares;
+  }
+  // Walk the proportional cumulative curve, rounding at each milestone
+  // boundary. Each share is the gap between consecutive rounded points,
+  // so the total lands on target by construction.
+  let cumulative = 0;
+  let previous = 0;
+  for (let i = 0; i < n; i++) {
+    cumulative += (Math.max(0, weights[i]) / total) * remaining;
+    const rounded = Math.round(cumulative);
+    shares[i] += rounded - previous;
+    previous = rounded;
+  }
+  // Correct any rounding drift into the last milestone.
+  const drift = target - shares.reduce((t, s2) => t + s2, 0);
+  if (drift !== 0) shares[n - 1] += drift;
+  return shares;
+};
+
+
+export const rebalanceMilestones = (
+  milestones: EstimateMilestone[],
+  request: RebalanceRequest,
+): RebalanceOutcome => {
+  if (!Number.isInteger(request.totalWeeks) || request.totalWeeks <= 0) {
+    return { ok: false, reason: "invalid-total", message: "totalWeeks must be a whole number greater than zero", releaseCandidates: [] };
+  }
+  const known = new Set(milestones.map((m) => m.id));
+  const pins = new Set((request.lockedIds ?? []).filter((id) => known.has(id)));
+  const cap = measure(milestones, pins);
+
+  const weeksOk = cap.lockedWeeks + cap.minUnlockedWeeks <= request.totalWeeks;
+  const payOk = cap.lockedPayment + cap.minUnlockedPayment <= 100;
+  if (!weeksOk || !payOk) {
+    const release = discoverReleasable(milestones, pins, request.totalWeeks);
+    return {
+      ok: false,
+      reason: "unsatisfiable",
+      message: release.length > 0
+        ? "The locked milestones leave too little room; release one of the named locks."
+        : "The timeline is too short for every milestone to keep at least one week.",
+      releaseCandidates: release,
+    };
+  }
+
+  const unlocked = milestones.filter((m) => !pins.has(m.id));
+  const weekShares = cumulativeRounding(
+    request.totalWeeks - cap.lockedWeeks,
+    unlocked.map((m) => m.weeks),
+  );
+  const payShares = cumulativeRounding(
+    100 - cap.lockedPayment,
+    unlocked.map((m) => m.paymentPercent),
+  );
+
+  let ui = 0;
+  const rebalanced = milestones.map((m) => {
+    if (pins.has(m.id)) return { ...m };
+    const idx = ui++;
+    return { ...m, weeks: weekShares[idx], paymentPercent: payShares[idx] };
+  });
+
+  return { ok: true, milestones: rebalanced };
+};
+
+export const compressForLaunch = (
+  milestones: EstimateMilestone[],
+  kickoff: string,
+  launch: string,
+  lockedIds: string[] = [],
+): RebalanceOutcome => {
+  const available = weeksUntil(kickoff, launch);
+  if (available <= 0) {
+    return { ok: false, reason: "unsatisfiable", message: "The launch date leaves no whole weeks after the kickoff.", releaseCandidates: [] };
+  }
+  const totalWeeks = milestones.reduce((t, m) => t + m.weeks, 0);
+  if (totalWeeks <= available) {
+    return { ok: true, milestones: milestones.map((m) => ({ ...m })) };
+  }
+  return rebalanceMilestones(milestones, { totalWeeks: available, lockedIds });
+};
