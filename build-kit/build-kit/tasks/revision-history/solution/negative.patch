diff --git a/tests/revisions.test.ts b/tests/revisions.test.ts
new file mode 100644
index 0000000..fa4110d
--- /dev/null
+++ b/tests/revisions.test.ts
@@ -0,0 +1,232 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import {
+  MAX_REVISIONS,
+  deleteRevision,
+  evictIfNeeded,
+  isValidRevisionName,
+  listRevisions,
+  loadRevision,
+  restoreRevision,
+  saveRevision,
+} from "../app/(site)/brief/revisions";
+import { makeBrief } from "./helpers";
+
+// localStorage mock that actually stores values
+const store = new Map<string, string>();
+
+const localStorageMock = {
+  getItem: (key: string) => store.get(key) ?? null,
+  setItem: (key: string, value: string) => void store.set(key, value),
+  removeItem: (key: string) => void store.delete(key),
+  clear: () => void store.clear(),
+  length: 0,
+  key: (_index: number) => null,
+};
+
+beforeEach(() => {
+  store.clear();
+  vi.stubGlobal("window", { localStorage: localStorageMock });
+});
+
+afterEach(() => {
+  vi.unstubAllGlobals();
+});
+
+describe("isValidRevisionName", () => {
+  it("rejects blank and whitespace-only names", () => {
+    expect(isValidRevisionName("")).toBe(false);
+    expect(isValidRevisionName("   ")).toBe(false);
+  });
+
+  it("rejects names longer than sixty characters", () => {
+    expect(isValidRevisionName("a".repeat(61))).toBe(false);
+    expect(isValidRevisionName("a".repeat(60))).toBe(true);
+  });
+
+  it("accepts normal names", () => {
+    expect(isValidRevisionName("draft")).toBe(true);
+    expect(isValidRevisionName("  version 2  ")).toBe(true);
+  });
+});
+
+describe("evictIfNeeded", () => {
+  it("returns the list unchanged when under the cap", () => {
+    const revisions = Array.from({ length: MAX_REVISIONS - 1 }, (_, i) => ({
+      id: `r${i}`,
+      name: `rev${i}`,
+      savedAt: `2026-01-0${(i % 9) + 1}T00:00:00Z`,
+      briefId: "b",
+      brief: makeBrief(),
+    }));
+    expect(evictIfNeeded(revisions, "r0")).toHaveLength(MAX_REVISIONS - 1);
+  });
+
+  it("drops the oldest non-anchor revision first", () => {
+    const revisions = Array.from({ length: MAX_REVISIONS + 1 }, (_, i) => ({
+      id: `r${i}`,
+      name: `rev${i}`,
+      savedAt: `2026-01-01T00:${String(i).padStart(2, "0")}:00Z`,
+      briefId: "b",
+      brief: makeBrief(),
+    }));
+    const kept = evictIfNeeded(revisions, "r0");
+    expect(kept).toHaveLength(MAX_REVISIONS);
+    expect(kept.some((r) => r.id === "r0")).toBe(true);
+    expect(kept.some((r) => r.id === "r1")).toBe(false);
+  });
+});
+
+describe("saveRevision and listRevisions", () => {
+  it("saves a revision and lists it newest first", () => {
+    const result = saveRevision(makeBrief(), "first draft");
+    expect(result.ok).toBe(true);
+
+    const second = saveRevision(makeBrief(), "after changes");
+    expect(second.ok).toBe(true);
+
+    const list = listRevisions();
+    expect(list.ok).toBe(true);
+    if (!list.ok) return;
+    expect(list.revisions).toHaveLength(2);
+    expect(list.revisions[0].name).toBe("after changes");
+    expect(list.revisions[1].name).toBe("first draft");
+  });
+
+  it("replaces a revision with the same name instead of duplicating", () => {
+    saveRevision(makeBrief(), "draft");
+    const updated = saveRevision(makeBrief({ projectName: "v2" }), "draft");
+    expect(updated.ok).toBe(true);
+
+    const list = listRevisions();
+    expect(list.ok).toBe(true);
+    if (!list.ok) return;
+    expect(list.revisions).toHaveLength(1);
+    expect(list.revisions[0].name).toBe("draft");
+  });
+
+  it("refuses a blank name", () => {
+    const result = saveRevision(makeBrief(), "   ");
+    expect(result.ok).toBe(false);
+    if (result.ok) return;
+    expect(result.reason).toBe("name-blank");
+  });
+});
+
+describe("loadRevision", () => {
+  it("loads a revision by name", () => {
+    const brief = makeBrief({ projectName: "checkpoint" });
+    saveRevision(brief, "checkpoint");
+    const loaded = loadRevision("checkpoint");
+    expect(loaded.ok).toBe(true);
+    if (!loaded.ok) return;
+    expect(loaded.revision.brief.projectName).toBe("checkpoint");
+  });
+
+  it("returns not-found for an unknown name", () => {
+    const result = loadRevision("does not exist");
+    expect(result.ok).toBe(false);
+    if (result.ok) return;
+    expect(result.reason).toBe("not-found");
+  });
+});
+
+describe("deleteRevision", () => {
+  it("deletes a non-anchor revision", () => {
+    saveRevision(makeBrief(), "first");
+    saveRevision(makeBrief(), "second");
+    const result = deleteRevision("second");
+    expect(result.ok).toBe(true);
+
+    const list = listRevisions();
+    expect(list.ok).toBe(true);
+    if (!list.ok) return;
+    expect(list.revisions).toHaveLength(1);
+    expect(list.revisions[0].name).toBe("first");
+  });
+
+  it("refuses to delete the anchor revision", () => {
+    saveRevision(makeBrief(), "the anchor");
+    saveRevision(makeBrief(), "later");
+    const result = deleteRevision("the anchor");
+    expect(result.ok).toBe(false);
+    if (result.ok) return;
+    expect(result.reason).toBe("anchor-protected");
+  });
+});
+
+describe("restoreRevision", () => {
+  it("creates a new revision instead of overwriting the original", () => {
+    saveRevision(makeBrief({ projectName: "original" }), "checkpoint");
+    const restored = restoreRevision("checkpoint");
+    expect(restored.ok).toBe(true);
+    if (!restored.ok) return;
+    expect(restored.revision.name).toBe("checkpoint (restored)");
+
+    const list = listRevisions();
+    expect(list.ok).toBe(true);
+    if (!list.ok) return;
+    expect(list.revisions).toHaveLength(2);
+
+    const original = loadRevision("checkpoint");
+    expect(original.ok).toBe(true);
+    if (!original.ok) return;
+    expect(original.revision.brief.projectName).toBe("original");
+  });
+
+  it("returns not-found when the revision does not exist", () => {
+    const result = restoreRevision("ghost");
+    expect(result.ok).toBe(false);
+    if (result.ok) return;
+    expect(result.reason).toBe("not-found");
+  });
+});
+
+
+describe("revision cap and eviction", () => {
+  it("caps the history at twenty revisions", () => {
+    for (let i = 0; i < 25; i++) {
+      const result = saveRevision(makeBrief({ projectName: `v${i}` }), `rev ${i}`);
+      expect(result.ok).toBe(true);
+    }
+    const list = listRevisions();
+    expect(list.ok).toBe(true);
+    if (!list.ok) return;
+    expect(list.revisions.length).toBeLessThanOrEqual(20);
+  });
+
+  it("keeps the anchor when evicting", () => {
+    saveRevision(makeBrief(), "anchor rev");
+    for (let i = 1; i < 25; i++) {
+      saveRevision(makeBrief(), `rev ${i}`);
+    }
+    const anchor = loadRevision("anchor rev");
+    expect(anchor.ok).toBe(true);
+  });
+
+  it("evicts oldest first when the cap is hit", () => {
+    saveRevision(makeBrief(), "anchor-old");
+    saveRevision(makeBrief(), "soon-gone");
+    for (let i = 3; i <= 22; i++) {
+      saveRevision(makeBrief(), `rev ${i}`);
+    }
+    const anchor = loadRevision("anchor-old");
+    expect(anchor.ok).toBe(true);
+    const evicted = loadRevision("soon-gone");
+    expect(evicted.ok).toBe(false);
+  });
+});
+
+describe("revision listing shape", () => {
+  it("returns metadata without the full brief", () => {
+    saveRevision(makeBrief(), "meta check");
+    const list = listRevisions();
+    expect(list.ok).toBe(true);
+    if (!list.ok) return;
+    const entry = list.revisions[0];
+    expect(entry).toHaveProperty("id");
+    expect(entry).toHaveProperty("name");
+    expect(entry).toHaveProperty("savedAt");
+    expect(entry).toHaveProperty("briefId");
+    expect(entry).not.toHaveProperty("brief");
+  });
+});
