diff --git a/app/(site)/brief/rebalance.ts b/app/(site)/brief/rebalance.ts
new file mode 100644
index 0000000..b5674bb
--- /dev/null
+++ b/app/(site)/brief/rebalance.ts
@@ -0,0 +1,211 @@
+import type { EstimateMilestone } from "./types";
+
+/**
+ * Locked milestone rebalancing.
+ *
+ * A client can pin the milestones they care about. When the timeline
+ * moves, the change is spread over the unpinned milestones only, every
+ * milestone keeps at least one week, the payment split still adds up to
+ * a hundred percent, and when the pins make the plan impossible the
+ * outcome names the pins to let go of.
+ */
+
+export type RebalanceRequest = {
+  totalWeeks: number;
+  lockedIds?: string[];
+};
+
+export type RebalanceSuccess = {
+  ok: true;
+  milestones: EstimateMilestone[];
+};
+
+export type RebalanceFailure = {
+  ok: false;
+  reason: "invalid-total" | "unsatisfiable";
+  message: string;
+  releaseCandidates: string[];
+};
+
+export type RebalanceOutcome = RebalanceSuccess | RebalanceFailure;
+
+const DAY_MS = 86_400_000;
+const WEEK_MS = 7 * DAY_MS;
+
+const isWholeNumber = (value: number): value is number =>
+  Number.isFinite(value) && Number.isInteger(value) && value > 0;
+
+/**
+ * Whole weeks between two ISO dates, rounded down. A launch earlier than
+ * the kickoff has no weeks at all.
+ */
+export const weeksUntil = (kickoff: string, launch: string): number => {
+  const start = new Date(kickoff).getTime();
+  const end = new Date(launch).getTime();
+  if (!Number.isFinite(start) || !Number.isFinite(end)) return 0;
+  return Math.max(0, Math.floor((end - start) / WEEK_MS));
+};
+
+/**
+ * Spread an amount over items in proportion to their weights, keeping a
+ * floor of one for every item and hitting the target exactly. Remainders
+ * go to the earlier items, so the result is deterministic.
+ */
+const distributeWithFloor = (target: number, weights: number[]): number[] => {
+  // Simple proportional split of the target, rounded, remainder to the top item.
+  const totalWeight = weights.reduce((total, weight) => total + Math.max(0, weight), 0);
+  if (weights.length === 0) return [];
+  if (totalWeight <= 0) return weights.map(() => Math.round(target / weights.length));
+  const shares = weights.map((weight) => Math.round((Math.max(0, weight) / totalWeight) * target));
+  const drift = target - shares.reduce((total, value) => total + value, 0);
+  if (drift !== 0 && shares.length > 0) {
+    shares[0] += drift;
+  }
+  return shares;
+};
+
+type Feasibility = { feasible: true } | { feasible: false; releaseCandidates: string[] };
+
+const checkWeeks = (
+  milestones: EstimateMilestone[],
+  locked: Set<string>,
+  totalWeeks: number,
+): Feasibility => {
+  const lockedWeeks = milestones
+    .filter((milestone) => locked.has(milestone.id))
+    .reduce((total, milestone) => total + milestone.weeks, 0);
+  const unlockedCount = milestones.filter((milestone) => !locked.has(milestone.id)).length;
+  if (lockedWeeks <= totalWeeks) return { feasible: true };
+
+  // Name the pins whose release alone would make the plan possible:
+  // the heaviest pins first, ties keeping catalog order.
+  const pins = milestones
+    .filter((milestone) => locked.has(milestone.id))
+    .map((milestone, index) => ({ id: milestone.id, weeks: milestone.weeks, index }))
+    .sort((a, b) => b.weeks - a.weeks || a.index - b.index);
+  const candidates: string[] = [];
+  let lockedSum = lockedWeeks;
+  for (const pin of pins) {
+    if (lockedSum + unlockedCount <= totalWeeks) break;
+    candidates.push(pin.id);
+    lockedSum -= pin.weeks;
+  }
+  return { feasible: false, releaseCandidates: candidates };
+};
+
+const checkPayments = (milestones: EstimateMilestone[], locked: Set<string>): Feasibility => {
+  const lockedPayment = milestones
+    .filter((milestone) => locked.has(milestone.id))
+    .reduce((total, milestone) => total + milestone.paymentPercent, 0);
+  const unlockedCount = milestones.filter((milestone) => !locked.has(milestone.id)).length;
+  if (lockedPayment + unlockedCount <= 100) return { feasible: true };
+
+  const pins = milestones
+    .filter((milestone) => locked.has(milestone.id))
+    .map((milestone, index) => ({ id: milestone.id, percent: milestone.paymentPercent, index }))
+    .sort((a, b) => b.percent - a.percent || a.index - b.index);
+  const candidates: string[] = [];
+  let paymentSum = lockedPayment;
+  for (const pin of pins) {
+    if (paymentSum + unlockedCount <= 100) break;
+    candidates.push(pin.id);
+    paymentSum -= pin.percent;
+  }
+  return { feasible: false, releaseCandidates: candidates };
+};
+
+/**
+ * Rebalance a milestone plan onto a new total. Locked milestones keep
+ * their weeks and their payment share; the unlocked ones absorb the
+ * change with at least one week and at least one percent each; both
+ * totals land exactly. Unknown lock ids are ignored. The input array is
+ * never mutated and the output keeps the original order and content.
+ */
+export const rebalanceMilestones = (
+  milestones: EstimateMilestone[],
+  request: RebalanceRequest,
+): RebalanceOutcome => {
+  if (!isWholeNumber(request.totalWeeks)) {
+    return {
+      ok: false,
+      reason: "invalid-total",
+      message: "totalWeeks must be a whole number greater than zero",
+      releaseCandidates: [],
+    };
+  }
+
+  const locked = new Set((request.lockedIds ?? []).filter((id) =>
+    milestones.some((milestone) => milestone.id === id),
+  ));
+
+  const weeksCheck = checkWeeks(milestones, locked, request.totalWeeks);
+  const paymentCheck = checkPayments(milestones, locked);
+  const blocked = !weeksCheck.feasible ? weeksCheck : !paymentCheck.feasible ? paymentCheck : null;
+  if (blocked) {
+    return {
+      ok: false,
+      reason: "unsatisfiable",
+      message:
+        blocked.releaseCandidates.length > 0
+          ? "The locked milestones leave too little room; release one of the named locks."
+          : "The timeline is too short for every milestone to keep at least one week.",
+      releaseCandidates: blocked.releaseCandidates,
+    };
+  }
+
+  const lockedWeeks = milestones
+    .filter((milestone) => locked.has(milestone.id))
+    .reduce((total, milestone) => total + milestone.weeks, 0);
+  const unlocked = milestones.filter((milestone) => !locked.has(milestone.id));
+  const unlockedWeeks = distributeWithFloor(
+    request.totalWeeks - lockedWeeks,
+    unlocked.map((milestone) => milestone.weeks),
+  );
+
+  const lockedPayment = milestones
+    .filter((milestone) => locked.has(milestone.id))
+    .reduce((total, milestone) => total + milestone.paymentPercent, 0);
+  const unlockedPayment = distributeWithFloor(
+    100 - lockedPayment,
+    unlocked.map((milestone) => milestone.paymentPercent),
+  );
+
+  let unlockedIndex = 0;
+  const rebalanced = milestones.map((milestone) => {
+    if (locked.has(milestone.id)) return { ...milestone };
+    const weeks = unlockedWeeks[unlockedIndex];
+    const paymentPercent = unlockedPayment[unlockedIndex];
+    unlockedIndex += 1;
+    return { ...milestone, weeks, paymentPercent };
+  });
+
+  return { ok: true, milestones: rebalanced };
+};
+
+/**
+ * Compress a plan to fit before a launch date. When the milestones
+ * already fit the available weeks the plan comes back unchanged, and a
+ * launch that cannot be met even at one week per unlocked milestone is
+ * refused with the pins that have to move.
+ */
+export const compressForLaunch = (
+  milestones: EstimateMilestone[],
+  kickoff: string,
+  launch: string,
+  lockedIds: string[] = [],
+): RebalanceOutcome => {
+  const available = weeksUntil(kickoff, launch);
+  const totalWeeks = milestones.reduce((total, milestone) => total + milestone.weeks, 0);
+  if (available <= 0) {
+    return {
+      ok: false,
+      reason: "unsatisfiable",
+      message: "The launch date leaves no whole weeks after the kickoff.",
+      releaseCandidates: [],
+    };
+  }
+  if (totalWeeks <= available) {
+    return { ok: true, milestones: milestones.map((milestone) => ({ ...milestone })) };
+  }
+  return rebalanceMilestones(milestones, { totalWeeks: available, lockedIds });
+};
diff --git a/tests/rebalance.test.ts b/tests/rebalance.test.ts
