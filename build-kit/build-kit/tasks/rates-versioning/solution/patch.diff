+"use client";
+
+import { buildRatesGapText } from "./export";
+import { getStampedVersion, ratesGap, snapshotRates } from "./rates";
+import type { ProjectBrief, RateTable } from "./types";
+
+export type RatesShiftProps = {
+  brief: ProjectBrief;
+};
+
+const legacyTable = (current: RateTable): RateTable => ({ ...current, version: 1 });
+
+export function RatesShift({ brief }: RatesShiftProps) {
+  const history = [legacyTable(snapshotRates()), snapshotRates()];
+  const stamped = getStampedVersion();
+  const gap = ratesGap(brief, history);
+
+  return (
+    <section className="brief-rates-shift">
+      <h3>Rates behind this estimate</h3>
+      {stamped.ok ? <p>Version {stamped.version}</p> : <p>{stamped.message}</p>}
+      {gap.ok ? (
+        <pre className="brief-rates-shift__gap">{buildRatesGapText(gap.gap)}</pre>
+      ) : (
+        <p>{gap.message}</p>
+      )}
+    </section>
+  );
+}
