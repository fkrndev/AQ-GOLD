@@ -0,0 +1,151 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { saveBrief } from "../app/(site)/brief/storage";
+import { createEmptyBrief } from "../app/(site)/brief/defaults";
+import { buildLifecycleText } from "../app/(site)/brief/export";
+import {
+  ensureEditable,
+  getFrozenEstimate,
+  getStatus,
+  getTrail,
+  transitionBrief,
+} from "../app/(site)/brief/lifecycle";
+
+const store = new Map<string, string>();
+const localStorageMock = {
+  getItem: (key: string) => store.get(key) ?? null,
+  setItem: (key: string, value: string) => void store.set(key, value),
+  removeItem: (key: string) => void store.delete(key),
+  clear: () => void store.clear(),
+  length: 0,
+  key: (_index: number) => null,
+};
+
+beforeEach(() => {
+  store.clear();
+  vi.stubGlobal("window", { localStorage: localStorageMock });
+});
+
+afterEach(() => {
+  vi.unstubAllGlobals();
+});
+
+const seedBrief = () => {
+  const brief = createEmptyBrief();
+  brief.projectName = "Lifecycle coverage";
+  saveBrief(brief);
+  return brief;
+};
+
+describe("lifecycle status", () => {
+  it("starts as draft", () => {
+    seedBrief();
+    expect(getStatus()).toBe("draft");
+  });
+
+  it("moves draft to in-review", () => {
+    seedBrief();
+    const result = transitionBrief("in-review");
+    expect(result.ok).toBe(true);
+    expect(getStatus()).toBe("in-review");
+  });
+
+  it("refuses a move that is not allowed", () => {
+    seedBrief();
+    const result = transitionBrief("signed-off");
+    expect(result.ok).toBe(false);
+    if (result.ok) return;
+    expect(result.reason).toBe("move-not-allowed");
+  });
+
+  it("requires a note to reopen a signed off brief", () => {
+    seedBrief();
+    transitionBrief("in-review");
+    transitionBrief("ready");
+    transitionBrief("signed-off");
+    const blank = transitionBrief("draft");
+    expect(blank.ok).toBe(false);
+    if (blank.ok) return;
+    expect(blank.reason).toBe("note-required");
+  });
+});
+
+describe("lifecycle trail", () => {
+  it("appends one event per move, oldest first", () => {
+    seedBrief();
+    transitionBrief("in-review");
+    transitionBrief("ready");
+    const trail = getTrail();
+    expect(trail.ok).toBe(true);
+    if (!trail.ok) return;
+    expect(trail.events).toHaveLength(2);
+    expect(trail.events[0].from).toBe(null);
+    expect(trail.events[1].from).toBe("in-review");
+  });
+
+  it("records the reopen note", () => {
+    seedBrief();
+    transitionBrief("in-review");
+    transitionBrief("ready");
+    transitionBrief("signed-off");
+    transitionBrief("draft", "client widened the scope");
+    const trail = getTrail();
+    expect(trail.ok).toBe(true);
+    if (!trail.ok) return;
+    const last = trail.events[trail.events.length - 1];
+    expect(last.note).toBe("client widened the scope");
+    expect(last.to).toBe("draft");
+  });
+
+  it("renders the trail as text", () => {
+    seedBrief();
+    transitionBrief("in-review");
+    const trail = getTrail();
+    if (!trail.ok) return;
+    expect(buildLifecycleText(trail.events)).toContain("start -> in-review");
+  });
+});
+
+describe("frozen estimate", () => {
+  it("is not frozen before sign off", () => {
+    seedBrief();
+    expect(getFrozenEstimate().ok).toBe(false);
+  });
+
+  it("freezes the estimate at sign off", () => {
+    seedBrief();
+    transitionBrief("in-review");
+    transitionBrief("ready");
+    transitionBrief("signed-off");
+    const frozen = getFrozenEstimate();
+    expect(frozen.ok).toBe(true);
+    if (!frozen.ok) return;
+    expect(frozen.estimate.estimatedHours).toBeGreaterThanOrEqual(0);
+  });
+});
+
+describe("edit guard", () => {
+  it("allows edits while drafting", () => {
+    seedBrief();
+    expect(ensureEditable().ok).toBe(true);
+  });
+
+  it("refuses edits once signed off", () => {
+    seedBrief();
+    transitionBrief("in-review");
+    transitionBrief("ready");
+    transitionBrief("signed-off");
+    const guard = ensureEditable();
+    expect(guard.ok).toBe(false);
+    if (guard.ok) return;
+    expect(guard.reason).toBe("signed-off");
+  });
+
+  it("allows edits again after a recorded reopen", () => {
+    seedBrief();
+    transitionBrief("in-review");
+    transitionBrief("ready");
+    transitionBrief("signed-off");
+    transitionBrief("draft", "back to the start");
+    expect(ensureEditable().ok).toBe(true);
+  });
+});
