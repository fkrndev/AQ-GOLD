+
+export interface ServiceRates {
+  maxCost: number;
+  minCost: number;
+  hours: number;
+}
+
+export type DeliverableRates = {
+  additionalHours: number;
+  additionalCost: number;
+};
+
+export interface RateTables {
+  deliverables: Record<string, DeliverableRates>;
+  services: Record<string, ServiceRates>;
+}
+
+export type RateTable = RateTables & {
+  version: number;
+};
+
+export type RateStamp = {
+  briefId: string;
+  version: number;
+  stampedAt: string;
+};
+
+export type RatesGapLine = {
+  id: string;
+  name: string;
+  hoursThen: number;
+  hoursNow: number;
+};
+
+export type RatesGap = {
+  versionThen: number;
+  versionNow: number;
+  hoursThen: number;
+  hoursNow: number;
+  minThen: number;
+  minNow: number;
+  maxThen: number;
+  maxNow: number;
+  changedLines: RatesGapLine[];
+};
