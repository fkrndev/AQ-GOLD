 };
+
+export type ServiceRates = {
+  hours: number;
+  minCost: number;
+  maxCost: number;
+};
+
+export type DeliverableRates = {
+  additionalHours: number;
+  additionalCost: number;
+};
+
+export type RateTables = {
+  services: Record<string, ServiceRates>;
+  deliverables: Record<string, DeliverableRates>;
+};
+
+export type RateTable = RateTables & {
+  version: number;
+};
+
+export type RateStamp = {
+  briefId: string;
+  version: number;
+  stampedAt: string;
+};
+
+export type RatesGapLine = {
+  id: string;
+  name: string;
+  hoursThen: number;
+  hoursNow: number;
+};
+
+export type RatesGap = {
+  versionThen: number;
+  versionNow: number;
+  hoursThen: number;
+  hoursNow: number;
+  minThen: number;
+  minNow: number;
+  maxThen: number;
+  maxNow: number;
+  changedLines: RatesGapLine[];
+};
