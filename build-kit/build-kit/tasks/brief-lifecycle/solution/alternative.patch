diff --git a/app/(site)/brief/lifecycle.ts b/app/(site)/brief/lifecycle.ts
new file mode 100644
index 0000000..31a9cbb
--- /dev/null
+++ b/app/(site)/brief/lifecycle.ts
@@ -0,0 +1,187 @@
+import { createEstimate } from "./estimate";
+import { loadBrief } from "./storage";
+import type { FrozenEstimate, LifecycleEvent, LifecycleStatus } from "./types";
+
+/**
+ * Phase tracking for the stored brief, kept in three small storage slots:
+ * the current phase, the numbers locked at sign off, and the running log.
+ * A phase only steps forward one place at a time, except a signed off brief
+ * which must be unlocked with a recorded note before it can be edited.
+ */
+
+const STATE_KEY = "dt-brief-phase";
+const LOCKED_KEY = "dt-brief-phase-locked";
+const LOG_KEY = "dt-brief-phase-log";
+
+const ORDER: LifecycleStatus[] = ["draft", "in-review", "ready", "signed-off"];
+
+const storageReady = (): boolean => {
+  if (typeof window === "undefined") return false;
+  try {
+    void window.localStorage.length;
+    return true;
+  } catch {
+    return false;
+  }
+};
+
+const readJson = (key: string): unknown => {
+  try {
+    const raw = window.localStorage.getItem(key);
+    return raw === null ? null : (JSON.parse(raw) as unknown);
+  } catch {
+    return null;
+  }
+};
+
+const writeJson = (key: string, value: unknown): boolean => {
+  try {
+    window.localStorage.setItem(key, JSON.stringify(value));
+    return true;
+  } catch {
+    return false;
+  }
+};
+
+const phaseOf = (raw: unknown): LifecycleStatus | null => {
+  return typeof raw === "string" && ORDER.includes(raw as LifecycleStatus) ? (raw as LifecycleStatus) : null;
+};
+
+interface StoredEvent {
+  at: string;
+  from: string | null;
+  to: string;
+  note: string;
+}
+
+const eventFrom = (raw: unknown): LifecycleEvent | null => {
+  if (typeof raw !== "object" || raw === null) return null;
+  const candidate = raw as Partial<StoredEvent>;
+  if (typeof candidate.at !== "string") return null;
+  if (typeof candidate.note !== "string") return null;
+  if (phaseOf(candidate.to) === null) return null;
+  if (candidate.from !== null && phaseOf(candidate.from) === null) return null;
+  return {
+    at: candidate.at,
+    from: candidate.from === null ? null : phaseOf(candidate.from),
+    to: phaseOf(candidate.to) as LifecycleStatus,
+    note: candidate.note,
+  };
+};
+
+const readLog = (): LifecycleEvent[] => {
+  const raw = readJson(LOG_KEY);
+  if (!Array.isArray(raw)) return [];
+  return raw.map(eventFrom).filter((entry): entry is LifecycleEvent => entry !== null);
+};
+
+const lockedFrom = (raw: unknown): FrozenEstimate | null => {
+  if (typeof raw !== "object" || raw === null) return null;
+  const candidate = raw as Record<string, unknown>;
+  const numbers = ["estimatedHours", "estimatedWeeks", "minCost", "maxCost"].every(
+    (field) => typeof candidate[field] === "number",
+  );
+  if (!numbers) return null;
+  if (candidate.risk !== "low" && candidate.risk !== "medium" && candidate.risk !== "high") return null;
+  return {
+    estimatedHours: candidate.estimatedHours as number,
+    estimatedWeeks: candidate.estimatedWeeks as number,
+    minCost: candidate.minCost as number,
+    maxCost: candidate.maxCost as number,
+    risk: candidate.risk,
+  };
+};
+
+const readPhase = (): LifecycleStatus => phaseOf(readJson(STATE_KEY)) ?? "draft";
+
+const stepFrom = (current: LifecycleStatus): LifecycleStatus | null => {
+  const index = ORDER.indexOf(current);
+  return index === ORDER.length - 1 ? null : ORDER[index + 1];
+};
+
+export const getStatus = (): LifecycleStatus => readPhase();
+
+export const transitionBrief = (
+  to: LifecycleStatus,
+  note = "",
+): { ok: true; status: LifecycleStatus; event: LifecycleEvent } | { ok: false; reason: "not-found" | "move-not-allowed" | "note-required" | "storage-unavailable"; message: string } => {
+  if (!storageReady()) {
+    return { ok: false, reason: "storage-unavailable", message: "Phase storage is not reachable." };
+  }
+  const brief = loadBrief();
+  if (brief === null) {
+    return { ok: false, reason: "not-found", message: "Save the brief before moving its phase." };
+  }
+  const current = readPhase();
+  const nextStep = stepFrom(current);
+  const reopening = current === "signed-off" && to === "draft";
+  if (to !== nextStep && !reopening) {
+    return { ok: false, reason: "move-not-allowed", message: `${current} cannot become ${to} in one move.` };
+  }
+  const cleaned = note.trim();
+  if (reopening && cleaned === "") {
+    return { ok: false, reason: "note-required", message: "An unlocked brief needs a note for the log." };
+  }
+  const hadPhase = readJson(STATE_KEY) !== null;
+  const entry: LifecycleEvent = {
+    at: new Date().toISOString(),
+    from: hadPhase ? current : null,
+    to,
+    note: cleaned,
+  };
+  const log = readLog();
+  if (!writeJson(LOG_KEY, [...log, entry])) {
+    return { ok: false, reason: "storage-unavailable", message: "The move could not be logged." };
+  }
+  if (!writeJson(STATE_KEY, to)) {
+    return { ok: false, reason: "storage-unavailable", message: "The phase could not be saved." };
+  }
+  if (to === "signed-off") {
+    const estimate = createEstimate(brief);
+    writeJson(LOCKED_KEY, {
+      estimatedHours: estimate.estimatedHours,
+      estimatedWeeks: estimate.estimatedWeeks,
+      minCost: estimate.minCost,
+      maxCost: estimate.maxCost,
+      risk: estimate.risk,
+    });
+  }
+  return { ok: true, status: to, event: entry };
+};
+
+export const getTrail = ():
+  | { ok: true; events: LifecycleEvent[] }
+  | { ok: false; reason: "not-found" | "storage-unavailable"; message: string } => {
+  if (!storageReady()) {
+    return { ok: false, reason: "storage-unavailable", message: "Phase storage is not reachable." };
+  }
+  if (loadBrief() === null) {
+    return { ok: false, reason: "not-found", message: "Save the brief before reading its log." };
+  }
+  return { ok: true, events: [...readLog()] };
+};
+
+export const getFrozenEstimate = ():
+  | { ok: true; estimate: FrozenEstimate }
+  | { ok: false; reason: "not-frozen" | "storage-unavailable"; message: string } => {
+  if (!storageReady()) {
+    return { ok: false, reason: "storage-unavailable", message: "Phase storage is not reachable." };
+  }
+  const locked = lockedFrom(readJson(LOCKED_KEY));
+  if (locked === null) {
+    return { ok: false, reason: "not-frozen", message: "Numbers lock when the brief is signed off." };
+  }
+  return { ok: true, estimate: locked };
+};
+
+export const ensureEditable = ():
+  | { ok: true }
+  | { ok: false; reason: "signed-off" | "storage-unavailable"; message: string } => {
+  if (!storageReady()) {
+    return { ok: false, reason: "storage-unavailable", message: "Phase storage is not reachable." };
+  }
+  if (readPhase() === "signed-off") {
+    return { ok: false, reason: "signed-off", message: "Locked at sign off. Unlock with a note first." };
+  }
+  return { ok: true };
+};
