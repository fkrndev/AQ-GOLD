diff --git a/app/(site)/brief/lifecycle.ts b/app/(site)/brief/lifecycle.ts
new file mode 100644
index 0000000..5f931bd
--- /dev/null
+++ b/app/(site)/brief/lifecycle.ts
@@ -0,0 +1,182 @@
+import { createEstimate } from "./estimate";
+import { loadBrief } from "./storage";
+import type { LifecycleEvent, LifecycleRecord, LifecycleStatus, FrozenEstimate } from "./types";
+
+/**
+ * Lifecycle for the brief. A brief used to be plain form data with no state
+ * of its own, so nobody could tell whether it was still being written or
+ * already agreed. This module gives it four statuses, rejects moves that are
+ * not allowed, freezes the estimate at sign off, forces a recorded reopen
+ * before a frozen brief can be edited again, and keeps an append only trail
+ * of every move. The trail is never rewritten; each move appends.
+ */
+
+const LIFECYCLE_KEY = "tripal-brief-lifecycle";
+
+const MOVES: Array<{ from: LifecycleStatus; to: LifecycleStatus; noteRequired: boolean }> = [
+  { from: "draft", to: "in-review", noteRequired: false },
+  { from: "in-review", to: "ready", noteRequired: false },
+  { from: "ready", to: "signed-off", noteRequired: false },
+  { from: "signed-off", to: "draft", noteRequired: true },
+];
+
+const STATUSES: LifecycleStatus[] = ["draft", "in-review", "ready", "signed-off"];
+
+const isStatus = (value: unknown): value is LifecycleStatus =>
+  typeof value === "string" && STATUSES.includes(value as LifecycleStatus);
+
+const canUseStorage = (): boolean =>
+  typeof window !== "undefined" && typeof window.localStorage !== "undefined";
+
+const parseRecord = (raw: unknown): LifecycleRecord | null => {
+  if (typeof raw !== "object" || raw === null) return null;
+  const obj = raw as Record<string, unknown>;
+  if (obj.schema !== 1 || !isStatus(obj.status) || !Array.isArray(obj.events)) return null;
+  const events: LifecycleEvent[] = [];
+  for (const entry of obj.events) {
+    if (typeof entry !== "object" || entry === null) continue;
+    const event = entry as Record<string, unknown>;
+    if (!isStatus(event.to) || typeof event.at !== "string" || typeof event.note !== "string") continue;
+    if (event.from !== null && !isStatus(event.from)) continue;
+    events.push({
+      at: event.at,
+      from: event.from as LifecycleStatus | null,
+      to: event.to,
+      note: event.note,
+    });
+  }
+  const frozen = parseFrozenEstimate(obj.frozenEstimate);
+  return frozen === null
+    ? { schema: 1, status: obj.status, events }
+    : { schema: 1, status: obj.status, frozenEstimate: frozen, events };
+};
+
+const parseFrozenEstimate = (raw: unknown): FrozenEstimate | null => {
+  if (typeof raw !== "object" || raw === null) return null;
+  const obj = raw as Record<string, unknown>;
+  if (typeof obj.estimatedHours !== "number" || typeof obj.estimatedWeeks !== "number") return null;
+  if (typeof obj.minCost !== "number" || typeof obj.maxCost !== "number") return null;
+  if (obj.risk !== "low" && obj.risk !== "medium" && obj.risk !== "high") return null;
+  return {
+    estimatedHours: obj.estimatedHours,
+    estimatedWeeks: obj.estimatedWeeks,
+    minCost: obj.minCost,
+    maxCost: obj.maxCost,
+    risk: obj.risk,
+  };
+};
+
+const readRecord = (): LifecycleRecord | null => {
+  if (!canUseStorage()) return null;
+  try {
+    const raw = window.localStorage.getItem(LIFECYCLE_KEY);
+    if (raw === null) return null;
+    return parseRecord(JSON.parse(raw));
+  } catch {
+    return null;
+  }
+};
+
+const writeRecord = (record: LifecycleRecord): boolean => {
+  if (!canUseStorage()) return false;
+  try {
+    window.localStorage.setItem(LIFECYCLE_KEY, JSON.stringify(record));
+    return true;
+  } catch {
+    return false;
+  }
+};
+
+const summarize = (estimate: ReturnType<typeof createEstimate>): FrozenEstimate => ({
+  estimatedHours: estimate.estimatedHours,
+  estimatedWeeks: estimate.estimatedWeeks,
+  minCost: estimate.minCost,
+  maxCost: estimate.maxCost,
+  risk: estimate.risk,
+});
+
+/** Current status of the stored brief. A brief with no moves yet is a draft. */
+export const getStatus = (): LifecycleStatus => {
+  const record = readRecord();
+  return record === null ? "draft" : record.status;
+};
+
+export const transitionBrief = (
+  to: LifecycleStatus,
+  note = "",
+): { ok: true; status: LifecycleStatus; event: LifecycleEvent } | { ok: false; reason: "not-found" | "move-not-allowed" | "note-required" | "storage-unavailable"; message: string } => {
+  if (!canUseStorage()) {
+    return { ok: false, reason: "storage-unavailable", message: "The lifecycle record is not accessible." };
+  }
+  const brief = loadBrief();
+  if (brief === null) {
+    return { ok: false, reason: "not-found", message: "There is no saved brief to move." };
+  }
+  const existing = readRecord();
+  const record = existing ?? { schema: 1 as const, status: "draft" as LifecycleStatus, events: [] };
+  const move = MOVES.find((candidate) => candidate.from === record.status && candidate.to === to);
+  if (!move) {
+    return { ok: false, reason: "move-not-allowed", message: `A brief cannot move from ${record.status} to ${to}.` };
+  }
+  const trimmed = note.trim();
+  if (move.noteRequired && trimmed === "") {
+    return { ok: false, reason: "note-required", message: "Reopening a signed off brief needs a recorded note." };
+  }
+  const event: LifecycleEvent = { at: new Date().toISOString(), from: existing === null ? null : record.status, to, note: trimmed };
+  const next: LifecycleRecord = {
+    schema: 1,
+    status: to,
+    frozenEstimate: record.frozenEstimate,
+    events: [...record.events, event],
+  };
+  if (to === "signed-off") {
+    next.frozenEstimate = summarize(createEstimate(brief));
+  }
+  if (!writeRecord(next)) {
+    return { ok: false, reason: "storage-unavailable", message: "The lifecycle record could not be saved." };
+  }
+  return { ok: true, status: to, event };
+};
+
+export const getTrail = ():
+  | { ok: true; events: LifecycleEvent[] }
+  | { ok: false; reason: "not-found" | "storage-unavailable"; message: string } => {
+  if (!canUseStorage()) {
+    return { ok: false, reason: "storage-unavailable", message: "The lifecycle record is not accessible." };
+  }
+  const brief = loadBrief();
+  if (brief === null) {
+    return { ok: false, reason: "not-found", message: "There is no saved brief to read." };
+  }
+  const record = readRecord();
+  return { ok: true, events: record === null ? [] : [...record.events] };
+};
+
+export const getFrozenEstimate = ():
+  | { ok: true; estimate: FrozenEstimate }
+  | { ok: false; reason: "not-frozen" | "storage-unavailable"; message: string } => {
+  if (!canUseStorage()) {
+    return { ok: false, reason: "storage-unavailable", message: "The lifecycle record is not accessible." };
+  }
+  const record = readRecord();
+  if (record === null || record.frozenEstimate === undefined || record.frozenEstimate === null) {
+    return { ok: false, reason: "not-frozen", message: "The estimate freezes when the brief is signed off." };
+  }
+  return { ok: true, estimate: record.frozenEstimate };
+};
+
+/**
+ * The edit guard. While the brief is signed off the numbers are frozen, so
+ * editing is refused until a recorded reopen moves it back to draft.
+ */
+export const ensureEditable = ():
+  | { ok: true }
+  | { ok: false; reason: "signed-off" | "storage-unavailable"; message: string } => {
+  if (!canUseStorage()) {
+    return { ok: false, reason: "storage-unavailable", message: "The lifecycle record is not accessible." };
+  }
+  if (getStatus() === "signed-off") {
+    return { ok: false, reason: "signed-off", message: "This brief is signed off. Record a reopen before editing." };
+  }
+  return { ok: true };
+};
