+++ b/tests/rates.test.ts
@@ -0,0 +1,188 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { createEstimate } from "../app/(site)/brief/estimate";
+import { buildRatesGapText } from "../app/(site)/brief/export";
+import {
+  CURRENT_RATES_VERSION,
+  LEGACY_RATES_VERSION,
+  estimateAtRates,
+  getStampedVersion,
+  ratesGap,
+  snapshotRates,
+  stampRates,
+  tableFor,
+} from "../app/(site)/brief/rates";
+import type { RateTable } from "../app/(site)/brief/types";
+import { deliverable, makeBrief, service } from "./helpers";
+
+const store = new Map<string, string>();
+const localStorageMock = {
+  getItem: (key: string) => store.get(key) ?? null,
+  setItem: (key: string, value: string) => void store.set(key, value),
+  removeItem: (key: string) => void store.delete(key),
+  clear: () => void store.clear(),
+  length: 0,
+  key: (_index: number) => null,
+};
+
+beforeEach(() => {
+  store.clear();
+  vi.stubGlobal("window", { localStorage: localStorageMock });
+});
+
+afterEach(() => {
+  vi.unstubAllGlobals();
+});
+
+const briefWithServices = () =>
+  makeBrief({ projectName: "Rates coverage", selectedServices: [service("brand-strategy"), service("website-development")] });
+
+/** v1 carries the same numbers today; v3 is a future edit of one service. */
+const history = (): RateTable[] => {
+  const current = snapshotRates();
+  const legacy: RateTable = { ...current, version: LEGACY_RATES_VERSION };
+  const bumped: RateTable = {
+    ...current,
+    version: 3,
+    services: {
+      ...current.services,
+      "brand-strategy": { ...current.services["brand-strategy"], hours: current.services["brand-strategy"].hours + 10 },
+    },
+  };
+  return [legacy, current, bumped];
+};
+
+describe("rate tables", () => {
+  it("snapshots today's numbers with the current version", () => {
+    const table = snapshotRates();
+    expect(table.version).toBe(CURRENT_RATES_VERSION);
+    expect(Object.keys(table.services).length).toBeGreaterThan(0);
+  });
+
+  it("finds a table by version", () => {
+    const tables = history();
+    expect(tableFor(tables, 3)?.version).toBe(3);
+    expect(tableFor(tables, 99)).toBe(null);
+  });
+});
+
+describe("stamps", () => {
+  it("reads the legacy version when nothing was stamped", () => {
+    const stamped = getStampedVersion();
+    expect(stamped.ok).toBe(true);
+    if (!stamped.ok) return;
+    expect(stamped.version).toBe(LEGACY_RATES_VERSION);
+  });
+
+  it("keeps a stamped version on read", () => {
+    const tables = history();
+    const stamped = stampRates("brief-1", tables[0].version, tables);
+    expect(stamped.ok).toBe(true);
+    const read = getStampedVersion();
+    expect(read.ok && read.version).toBe(tables[0].version);
+  });
+
+  it("refuses a version with no table", () => {
+    const refused = stampRates("brief-1", 99, history());
+    expect(refused.ok).toBe(false);
+  });
+});
+
+describe("estimate under a table", () => {
+  it("matches createEstimate under today's numbers", () => {
+    const brief = briefWithServices();
+    expect(estimateAtRates(brief, snapshotRates())).toEqual(createEstimate(brief));
+  });
+
+  it("moves when the table moves", () => {
+    const brief = briefWithServices();
+    const [legacy, , bumped] = history();
+    const then = estimateAtRates(brief, legacy);
+    const now = estimateAtRates(brief, bumped);
+    expect(now.estimatedHours).toBeGreaterThan(then.estimatedHours);
+  });
+});
+
+describe("gap", () => {
+  it("shows nothing when versions carry the same numbers", () => {
+    const gap = ratesGap(briefWithServices(), history().slice(0, 2));
+    expect(gap.ok).toBe(true);
+    if (!gap.ok) return;
+    expect(buildRatesGapText(gap.gap)).toBe("Rates unchanged");
+  });
+
+  it("lists the changed service when rates moved", () => {
+    const tables = history();
+    stampRates("brief-1", CURRENT_RATES_VERSION, tables);
+    const gap = ratesGap(briefWithServices(), tables);
+    expect(gap.ok).toBe(true);
+    if (!gap.ok) return;
+    expect(gap.gap.versionThen).toBe(CURRENT_RATES_VERSION);
+    const text = buildRatesGapText(gap.gap);
+    expect(text).toContain("Rates then and now");
+    expect(text).toContain("Total:");
+  });
+
+  it("keeps a legacy brief on its own numbers", () => {
+    const brief = briefWithServices();
+    const tables = history();
+    const legacyEstimate = estimateAtRates(brief, tables[0]);
+    const gap = ratesGap(brief, tables);
+    expect(gap.ok).toBe(true);
+    if (!gap.ok) return;
+    expect(gap.gap.hoursThen).toBe(legacyEstimate.estimatedHours);
+    expect(gap.gap.hoursNow).not.toBe(gap.gap.hoursThen);
+  });
+});
+
+describe("deliverable rates", () => {
+  it("follows deliverable rates from the table", () => {
+    const current = snapshotRates();
+    const pricier: RateTable = {
+      ...current,
+      version: 4,
+      deliverables: {
+        ...current.deliverables,
+        "photo-library": { ...current.deliverables["photo-library"], additionalCost: current.deliverables["photo-library"].additionalCost + 9000 },
+      },
+    };
+    const loaded = makeBrief({
+      projectName: "Deliverable rates",
+      selectedServices: [service("brand-strategy")],
+      deliverables: [deliverable("photo-library", "considering", 1)],
+    });
+    expect(estimateAtRates(loaded, pricier).minCost).toBeGreaterThan(estimateAtRates(loaded, current).minCost);
+  });
+
+  it("rejects a table whose version is a duplicate in spirit", () => {
