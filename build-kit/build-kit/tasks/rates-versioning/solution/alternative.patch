+++ b/tests/rates.test.ts
@@ -0,0 +1,118 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { createEstimate } from "../app/(site)/brief/estimate";
+import { buildRatesGapText } from "../app/(site)/brief/export";
+import {
+  CURRENT_RATES_VERSION,
+  LEGACY_RATES_VERSION,
+  estimateAtRates,
+  getStampedVersion,
+  ratesGap,
+  snapshotRates,
+  stampRates,
+  tableFor,
+} from "../app/(site)/brief/rates";
+import type { RateTable } from "../app/(site)/brief/types";
+import { makeBrief, service } from "./helpers";
+
+const backing = new Map<string, string>();
+const storageStub = {
+  getItem: (key: string) => backing.get(key) ?? null,
+  setItem: (key: string, value: string) => void backing.set(key, value),
+  removeItem: (key: string) => void backing.delete(key),
+  clear: () => backing.clear(),
+  length: 0,
+  key: (_index: number) => null,
+};
+
+beforeEach(() => {
+  backing.clear();
+  vi.stubGlobal("window", { localStorage: storageStub });
+});
+
+afterEach(() => {
+  vi.unstubAllGlobals();
+});
+
+const sampleBrief = () =>
+  makeBrief({ projectName: "Alt rates", selectedServices: [service("naming"), service("video-production")] });
+
+const tables = (): RateTable[] => {
+  const current = snapshotRates();
+  return [
+    { ...current, version: LEGACY_RATES_VERSION },
+    current,
+    {
+      ...current,
+      version: 3,
+      services: { ...current.services, naming: { ...current.services.naming, hours: current.services.naming.hours + 6 } },
+    },
+  ];
+};
+
+describe("table lookups", () => {
+  it("snapshots at the current version", () => {
+    expect(snapshotRates().version).toBe(CURRENT_RATES_VERSION);
+  });
+
+  it("misses versions that were never registered", () => {
+    expect(tableFor(tables(), 77)).toBe(null);
+  });
+});
+
+describe("stamp lifecycle", () => {
+  it("starts at legacy", () => {
+    const read = getStampedVersion();
+    expect(read.ok && read.version).toBe(LEGACY_RATES_VERSION);
+  });
+
+  it("holds the last explicit stamp", () => {
+    stampRates("alt-brief", 3, tables());
+    const read = getStampedVersion();
+    expect(read.ok && read.version).toBe(3);
+  });
+
+  it("rejects unknown versions without writing", () => {
+    expect(stampRates("alt-brief", 5, tables()).ok).toBe(false);
+    const read = getStampedVersion();
+    expect(read.ok && read.version).toBe(LEGACY_RATES_VERSION);
+  });
+});
+
+describe("versioned estimates", () => {
+  it("matches today's numbers exactly", () => {
+    expect(estimateAtRates(sampleBrief(), snapshotRates())).toEqual(createEstimate(sampleBrief()));
+  });
+
+  it("follows the table it is given", () => {
+    const list = tables();
+    expect(estimateAtRates(sampleBrief(), list[2]).estimatedHours).toBeGreaterThan(
+      estimateAtRates(sampleBrief(), list[0]).estimatedHours,
+    );
+  });
+});
+
+describe("gap reporting", () => {
+  it("reads as unchanged while numbers agree", () => {
+    const report = ratesGap(sampleBrief(), tables().slice(0, 2));
+    if (!report.ok) return;
+    expect(buildRatesGapText(report.gap)).toBe("Rates unchanged");
+  });
+
+  it("puts the stamped estimate first", () => {
+    const list = tables();
+    stampRates("alt-brief", 2, list);
+    const report = ratesGap(sampleBrief(), list);
+    if (!report.ok) return;
+    expect(report.gap.versionThen).toBe(2);
+    expect(report.gap.versionNow).toBe(3);
+    expect(buildRatesGapText(report.gap)).toContain("Total:");
+  });
+
+  it("leaves the stamp alone while reporting", () => {
+    const list = tables();
+    stampRates("alt-brief", 2, list);
+    ratesGap(sampleBrief(), list);
+    const read = getStampedVersion();
+    expect(read.ok && read.version).toBe(2);
+  });
+});
