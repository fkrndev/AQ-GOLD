diff --git a/app/(site)/brief/rates.ts b/app/(site)/brief/rates.ts
new file mode 100644
index 0000000..2d36cab
--- /dev/null
+++ b/app/(site)/brief/rates.ts
@@ -0,0 +1,164 @@
+import { createEstimate, todayRates } from "./estimate";
+import type { BriefEstimate, ProjectBrief, RateStamp, RateTable, RatesGap } from "./types";
+
+/**
+ * Rate versioning for the brief engine. A saved brief carries a stamp with
+ * the rate version it was estimated under, stored under its own storage
+ * slot. The stamp is only ever replaced by an explicit restamp, so a later
+ * rate edit never moves a saved brief's numbers. The gap report always
+ * reads original first, newest second.
+ */
+
+export const LEGACY_RATES_VERSION = 1;
+export const CURRENT_RATES_VERSION = 2;
+
+const STAMPS_KEY = "dt-rate-stamps";
+
+const storageThere = (): boolean => {
+  if (typeof window === "undefined") return false;
+  try {
+    void window.localStorage.length;
+    return true;
+  } catch {
+    return false;
+  }
+};
+
+interface StoredStamp {
+  briefId: string;
+  version: number;
+  stampedAt: string;
+}
+
+const validStamp = (raw: unknown): StoredStamp | null => {
+  if (typeof raw !== "object" || raw === null) return null;
+  const parsed = raw as Partial<StoredStamp>;
+  if (typeof parsed.briefId !== "string") return null;
+  if (typeof parsed.stampedAt !== "string") return null;
+  if (typeof parsed.version !== "number" || !Number.isFinite(parsed.version)) return null;
+  return { briefId: parsed.briefId, version: parsed.version, stampedAt: parsed.stampedAt };
+};
+
+/** All stamps live in one slot as a list, one entry per brief. */
+const readAllStamps = (): StoredStamp[] => {
+  try {
+    const raw = window.localStorage.getItem(STAMPS_KEY);
+    if (raw === null) return [];
+    const parsed = JSON.parse(raw) as unknown;
+    if (!Array.isArray(parsed)) return [];
+    return parsed.map(validStamp).filter((entry): entry is StoredStamp => entry !== null);
+  } catch {
+    return [];
+  }
+};
+
+const persistStamps = (stamps: StoredStamp[]): boolean => {
+  try {
+    window.localStorage.setItem(STAMPS_KEY, JSON.stringify(stamps));
+    return true;
+  } catch {
+    return false;
+  }
+};
+
+const currentStamp = (): StoredStamp | null => {
+  const all = readAllStamps();
+  return all.length === 0 ? null : all[all.length - 1];
+};
+
+/** Indexes a history by version so lookups do not scan. */
+const indexTables = (history: RateTable[]): Map<number, RateTable> => {
+  const index = new Map<number, RateTable>();
+  for (const table of history) index.set(table.version, table);
+  return index;
+};
+
+const latestVersionIn = (history: RateTable[]): number => {
+  let newest = 0;
+  for (const table of history) {
+    if (table.version > newest) newest = table.version;
+  }
+  return newest;
+};
+
+export const snapshotRates = (): RateTable => ({ ...todayRates(), version: CURRENT_RATES_VERSION });
+
+export const tableFor = (history: RateTable[], version: number): RateTable | null =>
+  indexTables(history).get(version) ?? null;
+
+export const getStampedVersion = ():
+  | { ok: true; version: number }
+  | { ok: false; reason: "storage-unavailable"; message: string } => {
+  if (!storageThere()) {
+    return { ok: false, reason: "storage-unavailable", message: "Rate stamps are not reachable." };
+  }
+  const stamp = currentStamp();
+  return { ok: true, version: stamp === null ? LEGACY_RATES_VERSION : stamp.version };
+};
+
+export const stampRates = (
+  briefId: string,
+  version: number,
+  history: RateTable[],
+): { ok: true; stamp: RateStamp } | { ok: false; reason: "version-unknown" | "storage-unavailable"; message: string } => {
+  if (!storageThere()) {
+    return { ok: false, reason: "storage-unavailable", message: "Rate stamps are not reachable." };
+  }
+  if (!indexTables(history).has(version)) {
+    return { ok: false, reason: "version-unknown", message: `Version ${version} has no rate table.` };
+  }
+  const stamp: StoredStamp = { briefId, version, stampedAt: new Date().toISOString() };
+  const others = readAllStamps().filter((entry) => entry.briefId !== briefId);
+  if (!persistStamps([...others, stamp])) {
+    return { ok: false, reason: "storage-unavailable", message: "The stamp could not be written." };
+  }
+  return { ok: true, stamp };
+};
+
+export const estimateAtRates = (brief: ProjectBrief, table: RateTable): BriefEstimate =>
+  createEstimate(brief, { services: table.services, deliverables: table.deliverables });
+
+export const ratesGap = (
+  brief: ProjectBrief,
+  history: RateTable[],
+):
+  | { ok: true; gap: RatesGap }
+  | { ok: false; reason: "version-unknown" | "storage-unavailable"; message: string } => {
+  if (!storageThere()) {
+    return { ok: false, reason: "storage-unavailable", message: "Rate stamps are not reachable." };
+  }
+  const index = indexTables(history);
+  const stamp = currentStamp();
+  const versionThen = stamp === null ? LEGACY_RATES_VERSION : stamp.version;
+  const thenTable = index.get(versionThen);
+  if (thenTable === undefined) {
+    return { ok: false, reason: "version-unknown", message: `Version ${versionThen} has no rate table.` };
+  }
+  const versionNow = latestVersionIn(history);
+  const nowTable = index.get(versionNow);
+  if (nowTable === undefined) {
+    return { ok: false, reason: "version-unknown", message: `Version ${versionNow} has no rate table.` };
+  }
+  const original = estimateAtRates(brief, thenTable);
+  const current = estimateAtRates(brief, nowTable);
+  const changedLines = [];
+  for (const line of current.lines) {
+    const before = original.lines.find((candidate) => candidate.id === line.id);
+    if (before === undefined || before.hours === line.hours) continue;
+    changedLines.push({ id: line.id, name: line.name, hoursThen: before.hours, hoursNow: line.hours });
+  }
+  return {
+    ok: true,
+    gap: {
+      versionThen,
+      versionNow,
+      hoursThen: original.estimatedHours,
+      hoursNow: current.estimatedHours,
+      minThen: original.minCost,
+      minNow: current.minCost,
+      maxThen: original.maxCost,
+      maxNow: current.maxCost,
+      changedLines,
+    },
+  };
+};
