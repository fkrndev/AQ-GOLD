diff --git a/tests/revisions.test.ts b/tests/revisions.test.ts
new file mode 100644
index 0000000..5b1a832
--- /dev/null
+++ b/tests/revisions.test.ts
@@ -0,0 +1,124 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import {
+  MAX_REVISIONS,
+  deleteRevision,
+  listRevisions,
+  loadRevision,
+  restoreRevision,
+  saveRevision,
+} from "../app/(site)/brief/revisions";
+import { buildRevisionListText } from "../app/(site)/brief/export";
+import { makeBrief } from "./helpers";
+
+const backing = new Map<string, string>();
+const storageStub = {
+  getItem: (key: string) => backing.get(key) ?? null,
+  setItem: (key: string, value: string) => void backing.set(key, value),
+  removeItem: (key: string) => void backing.delete(key),
+  clear: () => void backing.clear(),
+  length: 0,
+  key: (_index: number) => null,
+};
+
+beforeEach(() => {
+  backing.clear();
+  vi.stubGlobal("window", { localStorage: storageStub });
+});
+
+afterEach(() => {
+  vi.unstubAllGlobals();
+});
+
+const put = (name: string) => saveRevision(makeBrief(), name);
+
+describe("revision slots", () => {
+  it("stores a revision and lists it", () => {
+    const saved = put("first cut");
+    expect(saved.ok).toBe(true);
+    const list = listRevisions();
+    expect(list.ok && list.revisions.length === 1).toBe(true);
+  });
+
+  it("refuses a label that is only spaces", () => {
+    const refused = saveRevision(makeBrief(), "   ");
+    expect(refused.ok).toBe(false);
+  });
+
+  it("keeps one slot per label", () => {
+    put("checkpoint");
+    put("checkpoint");
+    const list = listRevisions();
+    expect(list.ok && list.revisions.length === 1).toBe(true);
+  });
+
+  it("leaves no slot behind when a label is replaced", () => {
+    put("checkpoint");
+    const before = backing.size;
+    put("checkpoint");
+    expect(backing.size).toBeLessThanOrEqual(before);
+  });
+});
+
+describe("history limit", () => {
+  it("holds at most twenty revisions", () => {
+    for (let i = 0; i < MAX_REVISIONS + 4; i += 1) {
+      put(`fill ${i}`);
+    }
+    const list = listRevisions();
+    expect(list.ok && list.revisions.length <= MAX_REVISIONS).toBe(true);
+  });
+
+  it("deletes the data of evicted revisions", () => {
+    for (let i = 0; i < MAX_REVISIONS + 3; i += 1) {
+      put(`fill ${i}`);
+    }
+    const slots = Array.from(backing.keys()).filter((key) => key.startsWith("double-tap-rev-"));
+    expect(slots.length).toBeLessThanOrEqual(MAX_REVISIONS);
+  });
+
+  it("protects the very first revision", () => {
+    put("the start");
+    for (let i = 1; i < MAX_REVISIONS + 3; i += 1) {
+      put(`fill ${i}`);
+    }
+    const anchor = loadRevision("the start");
+    expect(anchor.ok).toBe(true);
+    const refused = deleteRevision("the start");
+    expect(refused.ok).toBe(false);
+  });
+});
+
+describe("restore", () => {
+  it("appends a restored copy instead of replacing", () => {
+    put("source");
+    const restored = restoreRevision("source");
+    expect(restored.ok).toBe(true);
+    if (!restored.ok) return;
+    expect(restored.revision.name).toContain("restored");
+    const list = listRevisions();
+    expect(list.ok && list.revisions.length === 2).toBe(true);
+  });
+
+  it("keeps the source untouched", () => {
+    put("source");
+    restoreRevision("source");
+    const source = loadRevision("source");
+    expect(source.ok).toBe(true);
+  });
+});
+
+describe("export", () => {
+  it("lists names in the text", () => {
+    put("alpha");
+    put("beta");
+    const list = listRevisions();
+    if (!list.ok) return;
+    const text = buildRevisionListText(list.revisions);
+    expect(text).toContain("alpha");
+    expect(text).toContain("beta");
+  });
+
+  it("handles an empty history", () => {
+    expect(buildRevisionListText([])).toContain("No saved revisions");
+  });
+});
